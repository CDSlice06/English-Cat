@import "../wordbook/index.wxss";

.grammarbook .shelf-hero {
  background: linear-gradient(150deg, #fff9ee 0%, #f9e8d7 58%, #f3dac6 100%);
  border-color: rgba(199, 121, 63, 0.26);
  box-shadow: 7rpx 8rpx 0 rgba(199, 121, 63, 0.18);
}

.grammarbook .shelf-kicker { color: #a56338; }
.grammarbook .shelf-unit { color: #9a6b48; }

.shelf-caption {
  display: block;
  margin-top: 13rpx;
  color: #8c6b53;
  font-size: 21rpx;
}

.grammar-list {
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
  margin-top: 24rpx;
}

.grammar-card {
  position: relative;
  overflow: hidden;
  padding: var(--card-pad-y);
  border: 2rpx solid rgba(199, 121, 63, 0.22);
  border-radius: 24rpx 32rpx 26rpx 30rpx;
  background-color: #fffef9;
  background-image: repeating-linear-gradient(
    180deg,
    transparent 0,
    transparent 57rpx,
    rgba(199, 121, 63, 0.05) 57rpx,
    rgba(199, 121, 63, 0.05) 58rpx
  );
  box-shadow: 6rpx 7rpx 0 rgba(199, 121, 63, 0.11);
}

/* 每张语法卡微微歪一点，像夹在本子里的活页笔记 */
.grammar-card:nth-child(odd) { transform: rotate(-0.4deg); }
.grammar-card:nth-child(even) { transform: rotate(0.4deg); }

.grammar-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 30rpx;
  width: 86rpx;
  height: 11rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: rgba(199, 121, 63, 0.24);
}

.grammar-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.grammar-heading {
  flex: 1;
  min-width: 0;
}

.grammar-key {
  display: inline-block;
  padding: 5rpx 13rpx;
  border: 2rpx solid rgba(199, 121, 63, 0.18);
  border-radius: 8rpx 12rpx 9rpx 11rpx;
  background: #fff0d7;
  color: #9a5c30;
  font-size: 19rpx;
  font-weight: 700;
}

.grammar-title {
  display: block;
  margin-top: 12rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.55;
}

.grammar-remove {
  flex: none;
  padding: 5rpx 8rpx;
  color: #b6a992;
  font-size: 20rpx;
}

.grammar-sentence {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border: 2rpx dashed rgba(111, 145, 173, 0.34);
  border-left: 5rpx solid rgba(111, 145, 173, 0.58);
  border-radius: 15rpx 20rpx 16rpx 18rpx;
  background: rgba(241, 247, 251, 0.92);
}

.grammar-label {
  display: block;
  margin-bottom: 7rpx;
  color: var(--faint);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.grammar-sentence-text {
  display: block;
  color: var(--ink-2);
  font-size: 23rpx;
  line-height: 1.8;
}

.grammar-understanding {
  margin-top: 16rpx;
  padding: 15rpx 17rpx;
  border: 2rpx solid rgba(199, 121, 63, 0.15);
  border-radius: 12rpx 18rpx 14rpx 16rpx;
  background: #fff4d9;
  box-shadow: 3rpx 3rpx 0 rgba(199, 121, 63, 0.08);
}

.grammar-section { margin-top: 18rpx; }

/* ---------- 用法要点 ---------- */
.usage-block {
  padding: 15rpx 17rpx;
  border: 2rpx solid rgba(90, 132, 168, 0.2);
  border-radius: 14rpx 20rpx 16rpx 18rpx;
  background: rgba(238, 245, 250, 0.9);
  box-shadow: 3rpx 4rpx 0 rgba(90, 132, 168, 0.07);
}

.usage-tip {
  display: block;
  margin-bottom: 10rpx;
  color: #3f5c74;
  font-size: 22rpx;
  line-height: 1.8;
}

.usage-summary {
  display: block;
  padding: 10rpx 13rpx;
  border-left: 5rpx solid rgba(90, 132, 168, 0.5);
  border-radius: 0 10rpx 10rpx 0;
  background: rgba(255, 255, 255, 0.76);
  color: #3f5c74;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.78;
}

.usage-item {
  margin-top: 13rpx;
  padding-top: 13rpx;
  border-top: 1rpx dashed rgba(90, 132, 168, 0.22);
}

.usage-q {
  display: block;
  color: #3a5670;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.6;
}

.usage-a {
  display: block;
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.8;
}

.usage-example {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 8rpx;
  padding: 9rpx 12rpx;
  border-radius: 10rpx 14rpx 11rpx 13rpx;
}

.usage-good { background: rgba(232, 246, 236, 0.94); }
.usage-bad { background: rgba(252, 234, 230, 0.94); }

/* 正误标记用描边勾与手绘叉拼合，不用字符图标 */
.usage-mark {
  position: relative;
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin-top: 8rpx;
}

.usage-good .usage-mark::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 1rpx;
  width: 7rpx;
  height: 13rpx;
  border-right: 3rpx solid #4f9a71;
  border-bottom: 3rpx solid #4f9a71;
  border-radius: 0 0 2rpx 0;
  transform: rotate(40deg);
}

.usage-bad .usage-mark::before,
.usage-bad .usage-mark::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 3rpx;
  background: #c1655a;
  border-radius: 2rpx;
}

.usage-bad .usage-mark::before { transform: translate(-50%, -50%) rotate(-45deg); }
.usage-bad .usage-mark::after { transform: translate(-50%, -50%) rotate(45deg); }

.usage-example-text {
  flex: 1;
  min-width: 0;
  color: var(--ink-2);
  font-size: 21rpx;
  line-height: 1.7;
}

.grammar-body {
  display: block;
  color: var(--ink-2);
  font-size: 23rpx;
  line-height: 1.8;
}

/* ---------- 分步理解与分块翻译 ---------- */
.step-list {
  margin-top: 10rpx;
  padding: 6rpx 14rpx;
  border-top: 1rpx dashed rgba(199, 121, 63, 0.24);
}

.step-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 10rpx 0;
  border-top: 1rpx dashed rgba(199, 121, 63, 0.16);
}

.step-row:first-child {
  border-top: none;
  padding-top: 4rpx;
}

.step-index {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(116, 72, 40, 0.30);
  border-radius: 9rpx 7rpx 10rpx 8rpx;
  background: #fffdf5;
  color: #8a5a0d;
  font-size: 18rpx;
  font-weight: 700;
}

.step-body {
  flex: 1;
  min-width: 0;
}

.step-title {
  display: block;
  color: #6f4a15;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.55;
}

.step-detail {
  display: block;
  margin-top: 3rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.78;
}

.chunk-list {
  margin-bottom: 10rpx;
  padding: 10rpx 14rpx;
  border: 2rpx dashed rgba(111, 145, 173, 0.30);
  border-radius: 14rpx 18rpx 13rpx 17rpx;
  background: rgba(241, 247, 251, 0.72);
}

.chunk-row {
  padding: 8rpx 0;
  border-top: 1rpx dashed rgba(111, 145, 173, 0.20);
}

.chunk-row:first-child {
  border-top: none;
  padding-top: 2rpx;
}

.chunk-en {
  display: block;
  color: #3f5c74;
  font-size: 22rpx;
  line-height: 1.72;
}

.chunk-arrow {
  display: block;
  margin: 2rpx 0;
  color: rgba(111, 145, 173, 0.64);
  font-size: 19rpx;
  line-height: 1.2;
}

.chunk-zh {
  display: block;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.72;
}

.chunk-label {
  display: block;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(111, 145, 173, 0.22);
  color: var(--faint);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.example-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.example-card {
  padding: 13rpx 16rpx;
  border: 2rpx solid rgba(95, 168, 124, 0.15);
  border-radius: 14rpx 18rpx 13rpx 17rpx;
  background: rgba(239, 248, 241, 0.88);
}

.example-en,
.example-zh {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
}

.example-en { color: var(--ink-2); }
.example-zh { margin-top: 4rpx; color: var(--muted); }

.grammar-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 20rpx;
  padding-top: 15rpx;
  border-top: 1rpx dashed rgba(48, 40, 28, 0.12);
}

.grammar-source {
  flex: 1;
  min-width: 0;
  color: var(--faint);
  font-size: 19rpx;
  line-height: 1.55;
}

.grammar-stamp {
  flex: none;
  padding: 4rpx 12rpx;
  border: 2rpx solid rgba(95, 168, 124, 0.24);
  border-radius: 8rpx 11rpx 9rpx 10rpx;
  color: #4f8965;
  font-size: 18rpx;
  font-weight: 700;
  transform: rotate(-3deg);
}
