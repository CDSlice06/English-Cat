<view class="page pet-page">
  <view wx:if="{{loading}}" class="pet-state">
    <view class="state-cat">
      <view class="state-ear state-ear-l"></view>
      <view class="state-ear state-ear-r"></view>
      <view class="state-eye state-eye-l"></view>
      <view class="state-eye state-eye-r"></view>
    </view>
    <text class="state-text">正在把猫猫叫醒…</text>
  </view>

  <view wx:elif="{{error}}" class="pet-state">
    <view class="state-cat state-cat-sad">
      <view class="state-ear state-ear-l"></view>
      <view class="state-ear state-ear-r"></view>
      <view class="state-eye state-eye-l"></view>
      <view class="state-eye state-eye-r"></view>
    </view>
    <text class="state-text">{{error}}</text>
    <view class="state-retry" bindtap="load">重新加载</view>
  </view>

  <block wx:else>
    <view class="hero">
      <view class="sky">
        <view class="sun"></view>
        <view class="cloud cloud-a"></view>
        <view class="cloud cloud-b"></view>
        <view class="window">
          <view class="window-bar window-bar-v"></view>
          <view class="window-bar window-bar-h"></view>
        </view>
      </view>

      <view class="floor">
        <view class="rug"></view>
        <view class="dust dust-a"></view>
        <view class="dust dust-b"></view>
        <view class="dust dust-c"></view>
      </view>

      <view class="pet-wrap motion-{{motion}} mood-{{pet.mood.key}}">
        <view class="pet-shadow"></view>
        <view class="cat" bindtap="touchPet">
          <view class="cat-tail"></view>
          <view class="cat-body">
            <view class="cat-belly"></view>
            <view class="cat-stripe cat-stripe-a"></view>
            <view class="cat-stripe cat-stripe-b"></view>
          </view>
          <view class="cat-paw cat-paw-l"></view>
          <view class="cat-paw cat-paw-r"></view>
          <view class="cat-head">
            <view class="cat-ear cat-ear-l"><view class="ear-in"></view></view>
            <view class="cat-ear cat-ear-r"><view class="ear-in"></view></view>
            <view class="cat-face">
              <view class="cat-eye cat-eye-l"><view class="eye-dot"></view></view>
              <view class="cat-eye cat-eye-r"><view class="eye-dot"></view></view>
              <view class="cat-nose"></view>
              <view class="cat-mouth">
                <view class="mouth-l"></view>
                <view class="mouth-r"></view>
              </view>
              <view class="whisker whisker-l1"></view>
              <view class="whisker whisker-l2"></view>
              <view class="whisker whisker-r1"></view>
              <view class="whisker whisker-r2"></view>
            </view>
          </view>
        </view>

        <view wx:if="{{motion === 'feed'}}" class="fx fx-fish">
          <view class="fish-body"></view>
          <view class="fish-tail"></view>
        </view>
        <view wx:if="{{motion === 'play'}}" class="fx fx-heart fx-heart-a"></view>
        <view wx:if="{{motion === 'play'}}" class="fx fx-heart fx-heart-b"></view>
        <view wx:if="{{motion === 'touch'}}" class="fx fx-heart fx-heart-a"></view>
        <view wx:if="{{motion === 'clean'}}" class="fx fx-bubble fx-bubble-a"></view>
        <view wx:if="{{motion === 'clean'}}" class="fx fx-bubble fx-bubble-b"></view>
        <view wx:if="{{motion === 'sleep'}}" class="fx fx-zzz">Z z</view>
      </view>

      <view class="hero-meta">
        <view class="hero-title-row">
          <text class="pet-name">{{pet.name}}</text>
          <text class="mood-chip mood-chip-{{pet.mood.key}}">{{pet.mood.label}}</text>
        </view>
        <text class="pet-stage">{{pet.stage.name}} · {{pet.stage.title}}</text>
        <view class="stage-track">
          <view class="stage-fill" style="width: {{pet.stage.progress}}%"></view>
        </view>
        <view class="stage-row">
          <text class="stage-hint">{{pet.stage.nextText}}</text>
          <text class="stage-exp">{{pet.stage.exp}} EXP</text>
        </view>
      </view>
    </view>

    <view wx:if="{{pet.awayHours}}" class="away">
      <text class="away-dot"></text>
      <text>你离开了 {{pet.awayHours}} 小时，{{pet.name}}一直在等你</text>
    </view>

    <view class="stats-card">
      <view wx:for="{{pet.stats}}" wx:key="key" class="stat-row">
        <text class="stat-label">{{item.label}}</text>
        <view class="stat-track">
          <view class="stat-fill fill-{{item.key}}" style="width: {{item.value}}%"></view>
        </view>
        <text class="stat-value">{{item.value}}</text>
      </view>
    </view>

    <view class="actions">
      <view
        wx:for="{{pet.actions}}"
        wx:key="key"
        class="action {{acting ? 'action-busy' : ''}} {{item.cooling ? 'action-cool' : ''}}"
        data-action="{{item.key}}"
        bindtap="act"
      >
        <view class="action-mark mark-{{item.key}}"></view>
        <text class="action-label">{{item.label}}</text>
        <text class="action-hint">{{item.cooling ? '等一会' : item.hint}}</text>
      </view>
    </view>

    <view class="quest-card">
      <view class="quest-head">
        <view class="quest-copy">
          <text class="quest-kicker">DAILY CARE</text>
          <text class="quest-title">今日照顾</text>
        </view>
        <text class="quest-date">{{pet.daily.date}}</text>
      </view>

      <view wx:for="{{pet.daily.quests}}" wx:key="key" class="quest-row">
        <view class="quest-check {{item.done ? 'quest-check-on' : ''}}"></view>
        <text class="quest-text {{item.done ? 'quest-text-on' : ''}}">{{item.label}}</text>
      </view>

      <view
        class="claim {{pet.daily.canClaim ? 'claim-on' : ''}} {{pet.daily.claimed ? 'claim-done' : ''}}"
        bindtap="claim"
      >
        <text>{{pet.daily.claimed ? '今日奖励已领取' : (pet.daily.canClaim ? '领取成长值 +' + pet.daily.reward : '完成三件事可领 +' + pet.daily.reward)}}</text>
      </view>
    </view>

    <view class="tip">
      <text class="tip-mark">“</text>
      <text class="tip-text">{{pet.tip}}</text>
    </view>

    <view class="study-link" bindtap="goStudy">
      <view class="study-link-copy">
        <text class="study-link-kicker">LEARN · FEED</text>
        <text class="study-link-text">去学习，给{{pet.name}}换零食</text>
      </view>
      <view class="study-link-arrow"></view>
    </view>
  </block>
</view>
