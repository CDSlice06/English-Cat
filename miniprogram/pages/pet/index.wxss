.pet-page {
  padding-bottom: 70rpx;
}

/* ---------- 加载 / 错误 ---------- */
.pet-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}

.state-cat {
  position: relative;
  width: 160rpx;
  height: 140rpx;
  border: 3rpx solid rgba(116, 72, 40, 0.4);
  border-radius: 50% 50% 46% 46%;
  background: linear-gradient(160deg, #ffd9a0, #f3b26d);
  animation: breathe 3s ease-in-out infinite;
}

.state-ear {
  position: absolute;
  top: -26rpx;
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-bottom: 40rpx solid #f3b26d;
}

.state-ear-l { left: 12rpx; transform: rotate(-12deg); }
.state-ear-r { right: 12rpx; transform: rotate(12deg); }

.state-eye {
  position: absolute;
  top: 62rpx;
  width: 18rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #3b2a1d;
  animation: blink 3.6s infinite;
}

.state-eye-l { left: 44rpx; }
.state-eye-r { right: 44rpx; }
.state-cat-sad .state-eye { animation: none; height: 4rpx; border-radius: 4rpx; margin-top: 12rpx; }

.state-text {
  margin-top: 34rpx;
  color: #8a6a4d;
  font-size: 26rpx;
}

.state-retry {
  margin-top: 26rpx;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  background: #f2b45c;
  color: #4a2e12;
  font-size: 26rpx;
  font-weight: 700;
}

/* ---------- 场景 ---------- */
.hero {
  position: relative;
  margin: 24rpx 32rpx 0;
  padding-top: 470rpx;
  border: 2rpx solid rgba(116, 72, 40, 0.42);
  border-radius: 34rpx;
  background: #fff6e5;
  box-shadow: 0 20rpx 44rpx rgba(120, 80, 40, 0.16);
  overflow: hidden;
}

.sky {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 470rpx;
  background: linear-gradient(180deg, #dff2ff 0%, #f2f8f2 56%, #fff3d9 100%);
}

.sun {
  position: absolute;
  top: 44rpx;
  left: 56rpx;
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: #ffd36b;
  box-shadow: 0 0 0 18rpx rgba(255, 211, 107, 0.24), 0 0 40rpx rgba(255, 196, 77, 0.55);
}

.cloud {
  position: absolute;
  height: 34rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.9);
}

.cloud-a {
  top: 70rpx;
  right: 210rpx;
  width: 120rpx;
  animation: drift 16s ease-in-out infinite;
}

.cloud-b {
  top: 140rpx;
  right: 70rpx;
  width: 88rpx;
  opacity: 0.72;
  animation: drift 21s ease-in-out infinite reverse;
}

.window {
  position: absolute;
  top: 46rpx;
  right: 46rpx;
  width: 150rpx;
  height: 190rpx;
  border: 5rpx solid rgba(160, 112, 66, 0.55);
  border-radius: 18rpx;
  background: linear-gradient(180deg, #cbe9ff, #eef8ff);
  overflow: hidden;
}

.window-bar {
  position: absolute;
  background: rgba(160, 112, 66, 0.42);
}

.window-bar-v { top: 0; bottom: 0; left: 50%; width: 3rpx; }
.window-bar-h { left: 0; right: 0; top: 50%; height: 3rpx; }

.floor {
  position: absolute;
  left: 0;
  right: 0;
  top: 330rpx;
  height: 140rpx;
  background: linear-gradient(180deg, #f3d6a8, #e7bf87);
  box-shadow: inset 0 8rpx 14rpx rgba(255, 255, 255, 0.4);
}

.floor::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: repeating-linear-gradient(90deg, rgba(139, 92, 50, 0.1) 0 2rpx, transparent 2rpx 92rpx);
}

.rug {
  position: absolute;
  left: 50%;
  bottom: 30rpx;
  width: 380rpx;
  height: 84rpx;
  margin-left: -190rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, #f9d9c3 0%, #f0c3a5 68%, #e6b08f 100%);
  box-shadow: inset 0 6rpx 12rpx rgba(255, 255, 255, 0.5);
}

.dust {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 244, 214, 0.9);
  animation: floatDust 7s ease-in-out infinite;
}

.dust-a { left: 120rpx; top: 210rpx; }
.dust-b { left: 470rpx; top: 150rpx; animation-delay: 1.4s; }
.dust-c { left: 560rpx; top: 260rpx; animation-delay: 2.6s; }

/* ---------- 猫 ---------- */
.pet-wrap {
  position: absolute;
  top: 120rpx;
  left: 50%;
  width: 320rpx;
  height: 310rpx;
  margin-left: -160rpx;
  z-index: 3;
}

.pet-shadow {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 230rpx;
  height: 36rpx;
  margin-left: -115rpx;
  border-radius: 50%;
  background: rgba(110, 70, 40, 0.2);
  filter: blur(6rpx);
  animation: shadowPulse 3.4s ease-in-out infinite;
}

.cat {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 220rpx;
  height: 250rpx;
  margin-left: -110rpx;
  transform-origin: bottom center;
  animation: breathe 3.4s ease-in-out infinite;
}

.cat-tail {
  position: absolute;
  right: -52rpx;
  bottom: 44rpx;
  width: 118rpx;
  height: 34rpx;
  border-radius: 30rpx;
  background: linear-gradient(90deg, #f4ae6a 0%, #eda15f 70%, #e0913f 100%);
  box-shadow: inset -16rpx 0 0 rgba(173, 102, 47, 0.2);
  transform-origin: left center;
  animation: tailWag 2.4s ease-in-out infinite;
}

.cat-body {
  position: absolute;
  left: 25rpx;
  bottom: 0;
  width: 170rpx;
  height: 152rpx;
  border-radius: 82rpx 82rpx 54rpx 54rpx;
  background: linear-gradient(155deg, #f9c084 0%, #f2a962 62%, #e99a52 100%);
  box-shadow: inset -12rpx -14rpx 0 rgba(196, 124, 64, 0.16);
}

.cat-belly {
  position: absolute;
  left: 44rpx;
  bottom: 12rpx;
  width: 82rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff3de;
  opacity: 0.92;
}

.cat-stripe {
  position: absolute;
  width: 8rpx;
  height: 34rpx;
  border-radius: 8rpx;
  background: rgba(196, 124, 64, 0.32);
}

.cat-stripe-a { left: 52rpx; bottom: 96rpx; transform: rotate(12deg); }
.cat-stripe-b { right: 52rpx; bottom: 96rpx; transform: rotate(-12deg); }

.cat-paw {
  position: absolute;
  bottom: -6rpx;
  width: 66rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #f9c084;
  box-shadow: inset 0 -6rpx 0 rgba(196, 124, 64, 0.14);
}

.cat-paw-l { left: 22rpx; }
.cat-paw-r { right: 22rpx; }

.cat-head {
  position: absolute;
  top: 0;
  left: 10rpx;
  width: 200rpx;
  height: 160rpx;
  border-radius: 48% 48% 44% 44%;
  background: linear-gradient(160deg, #fac78f 0%, #f4ae6a 70%, #eba059 100%);
  box-shadow: inset -10rpx -12rpx 0 rgba(196, 124, 64, 0.12);
  z-index: 2;
}

.cat-ear {
  position: absolute;
  top: -30rpx;
  width: 0;
  height: 0;
  border-left: 32rpx solid transparent;
  border-right: 32rpx solid transparent;
  border-bottom: 56rpx solid #f4ae6a;
}

.cat-ear-l { left: 12rpx; transform: rotate(-14deg); }
.cat-ear-r { right: 12rpx; transform: rotate(14deg); }

.ear-in {
  position: absolute;
  top: 22rpx;
  left: -18rpx;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-bottom: 32rpx solid #ffd9c2;
}

.cat-face {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.cat-eye {
  position: absolute;
  top: 66rpx;
  width: 20rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #3b2a1d;
  animation: blink 4.4s infinite;
  transform-origin: center;
}

.cat-eye-l { left: 50rpx; }
.cat-eye-r { right: 50rpx; }

.eye-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #fff;
}

.cat-nose {
  position: absolute;
  top: 104rpx;
  left: 50%;
  margin-left: -11rpx;
  width: 0;
  height: 0;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-top: 13rpx solid #d9776b;
}

.cat-mouth {
  position: absolute;
  top: 112rpx;
  left: 50%;
  width: 64rpx;
  margin-left: -32rpx;
  height: 26rpx;
}

.mouth-l,
.mouth-r {
  position: absolute;
  top: 0;
  width: 26rpx;
  height: 18rpx;
  border-bottom: 4rpx solid #8a5a3b;
  border-radius: 0 0 26rpx 26rpx;
}

.mouth-l { left: 6rpx; transform: rotate(-6deg); }
.mouth-r { right: 6rpx; transform: rotate(6deg); }

.whisker {
  position: absolute;
  width: 42rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: rgba(120, 78, 46, 0.42);
}

.whisker-l1 { left: -22rpx; top: 104rpx; transform: rotate(8deg); }
.whisker-l2 { left: -22rpx; top: 120rpx; transform: rotate(-8deg); }
.whisker-r1 { right: -22rpx; top: 104rpx; transform: rotate(-8deg); }
.whisker-r2 { right: -22rpx; top: 120rpx; transform: rotate(8deg); }

/* 动作反馈 */
.motion-feed .cat { animation: hop 0.8s ease; }
.motion-play .cat { animation: spin 0.8s ease; }
.motion-clean .cat { animation: shake 0.7s ease; }
.motion-touch .cat { animation: wiggle 0.7s ease; }
.motion-sleep .cat { animation: breathe 2.8s ease-in-out infinite; }
.motion-sleep .cat-eye {
  animation: none;
  height: 5rpx;
  margin-top: 12rpx;
  border-radius: 5rpx;
}

.fx {
  position: absolute;
  z-index: 4;
}

.fx-fish {
  top: 40rpx;
  right: 20rpx;
  width: 70rpx;
  height: 34rpx;
  animation: fishDrop 0.8s ease forwards;
}

.fish-body {
  position: absolute;
  left: 0;
  top: 0;
  width: 48rpx;
  height: 34rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #ffd28a, #f6a94f);
}

.fish-tail {
  position: absolute;
  right: 0;
  top: 3rpx;
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 20rpx solid #f6a94f;
}

.fx-heart {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #ff9c9c;
  animation: heartRise 0.9s ease forwards;
}

.fx-heart-a { top: 30rpx; left: 40rpx; }
.fx-heart-b { top: 60rpx; right: 34rpx; animation-delay: 0.12s; }

.fx-bubble {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid rgba(126, 190, 206, 0.85);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  animation: bubbleUp 0.9s ease forwards;
}

.fx-bubble-a { top: 40rpx; left: 30rpx; }
.fx-bubble-b { top: 80rpx; right: 24rpx; width: 22rpx; height: 22rpx; animation-delay: 0.15s; }

.fx-zzz {
  top: 10rpx;
  right: 34rpx;
  color: #6f89a6;
  font-family: 'Iowan Old Style', Georgia, serif;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  animation: zzzFloat 1s ease forwards;
}

/* ---------- 场景信息 ---------- */
.hero-meta {
  position: relative;
  z-index: 5;
  margin: 16rpx 20rpx 20rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(150, 102, 58, 0.26);
  border-radius: 24rpx;
  background: rgba(255, 250, 240, 0.94);
}

.hero-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pet-name {
  color: #3d2d1c;
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 40rpx;
  font-weight: 700;
}

.mood-chip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.mood-chip-great { background: #e2f2dd; color: #4f8a54; }
.mood-chip-good { background: #e6f3e0; color: #5f8f52; }
.mood-chip-ok { background: #fdf0d3; color: #a5751f; }
.mood-chip-low { background: #fde8d8; color: #bb6a3a; }
.mood-chip-bad { background: #fbe2e2; color: #b94c4c; }

.pet-stage {
  display: block;
  margin-top: 6rpx;
  color: #9b7b5f;
  font-size: 22rpx;
}

.stage-track {
  margin-top: 16rpx;
  height: 12rpx;
  border-radius: 12rpx;
  background: #f0e2cd;
  overflow: hidden;
}

.stage-fill {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f6c264, #ec9f45);
  transition: width 0.4s ease;
}

.stage-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.stage-hint {
  color: #a5866a;
  font-size: 20rpx;
}

.stage-exp {
  color: #b07b34;
  font-family: 'Iowan Old Style', Georgia, serif;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* ---------- 离开提示 ---------- */
.away {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 32rpx 0;
  padding: 16rpx 22rpx;
  border-radius: 18rpx;
  background: #fdf3e0;
  color: #9b7b4a;
  font-size: 22rpx;
}

.away-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #f0b45a;
}

/* ---------- 数值 ---------- */
.stats-card {
  margin: 24rpx 32rpx 0;
  padding: 24rpx 26rpx;
  border: 2rpx solid rgba(150, 102, 58, 0.26);
  border-radius: 28rpx;
  background: #fffdf7;
  box-shadow: 0 10rpx 24rpx rgba(120, 80, 40, 0.07);
}

.stat-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.stat-row + .stat-row {
  margin-top: 20rpx;
}

.stat-label {
  width: 60rpx;
  color: #7c5a3c;
  font-size: 23rpx;
  font-weight: 600;
}

.stat-track {
  flex: 1;
  height: 16rpx;
  border-radius: 16rpx;
  background: #f2e7d6;
  overflow: hidden;
}

.stat-fill {
  height: 100%;
  border-radius: 16rpx;
  transition: width 0.45s ease;
}

.fill-food { background: linear-gradient(90deg, #f9c66e, #ef9d43); }
.fill-mood { background: linear-gradient(90deg, #f6a6a6, #e87373); }
.fill-clean { background: linear-gradient(90deg, #9fd6df, #64aebd); }
.fill-energy { background: linear-gradient(90deg, #b5d99c, #7fba68); }

.stat-value {
  width: 46rpx;
  color: #6b4a2e;
  font-size: 22rpx;
  font-weight: 700;
  text-align: right;
}

/* ---------- 动作 ---------- */
.actions {
  display: flex;
  gap: 14rpx;
  margin: 24rpx 32rpx 0;
}

.action {
  flex: 1;
  padding: 18rpx 6rpx 16rpx;
  border: 2rpx solid rgba(150, 102, 58, 0.28);
  border-radius: 24rpx;
  background: #fffaf0;
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(150, 100, 60, 0.1);
}

.action-busy { opacity: 0.72; }
.action-cool { opacity: 0.55; }

.action-mark {
  width: 46rpx;
  height: 46rpx;
  margin: 0 auto 10rpx;
}

.mark-feed {
  position: relative;
  border-radius: 50% 50% 50% 10rpx;
  background: linear-gradient(140deg, #ffd28a, #f2a04a);
  transform: rotate(-45deg);
}

.mark-feed::after {
  content: '';
  position: absolute;
  right: -12rpx;
  top: 12rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 14rpx solid #f2a04a;
  transform: rotate(40deg);
}

.mark-play {
  border: 6rpx solid #e3a15c;
  border-radius: 50%;
  background: #fff3dc;
  box-shadow: inset 0 -8rpx 0 rgba(227, 161, 92, 0.2);
}

.mark-clean {
  border: 5rpx solid #7bbac8;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
}

.mark-sleep {
  border-radius: 50%;
  background: transparent;
  box-shadow: inset -12rpx 4rpx 0 0 #8aa6c8;
}

.action-label {
  display: block;
  color: #5c3d24;
  font-size: 25rpx;
  font-weight: 700;
}

.action-hint {
  display: block;
  margin-top: 4rpx;
  color: #a5866a;
  font-size: 18rpx;
}

/* ---------- 今日照顾 ---------- */
.quest-card {
  margin: 24rpx 32rpx 0;
  padding: 26rpx 28rpx;
  border: 2rpx solid rgba(150, 102, 58, 0.28);
  border-radius: 28rpx;
  background: #fffdf7;
  box-shadow: 0 10rpx 24rpx rgba(120, 80, 40, 0.07);
}

.quest-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.quest-copy {
  display: flex;
  flex-direction: column;
}

.quest-kicker {
  color: #b0916c;
  font-family: 'Iowan Old Style', Georgia, serif;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2.6rpx;
}

.quest-title {
  margin-top: 6rpx;
  color: #3d2d1c;
  font-size: 32rpx;
  font-weight: 700;
}

.quest-date {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f4e8d5;
  color: #9b7b5f;
  font-size: 19rpx;
}

.quest-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx dashed rgba(160, 118, 76, 0.2);
}

.quest-check {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid #cbaa84;
  border-radius: 50%;
  background: #fff;
}

.quest-check-on {
  border-color: #7fbf8a;
  background: #7fbf8a;
}

.quest-check-on::after {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 9rpx;
  width: 9rpx;
  height: 16rpx;
  border-right: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(42deg);
}

.quest-text {
  color: #6b4a2e;
  font-size: 24rpx;
}

.quest-text-on {
  color: #8fae8a;
  text-decoration: line-through;
}

.claim {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f1e5d3;
  color: #9b7b5f;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.claim-on {
  background: linear-gradient(135deg, #f8c46a, #eda044);
  color: #4a2e12;
  box-shadow: 0 8rpx 18rpx rgba(222, 156, 60, 0.32);
}

.claim-done {
  background: #e8f2e6;
  color: #5e8f62;
}

/* ---------- 台词 / 学习入口 ---------- */
.tip {
  position: relative;
  margin: 24rpx 32rpx 0;
  padding: 22rpx 26rpx 22rpx 42rpx;
  border-left: 8rpx solid #f0b96b;
  border-radius: 0 20rpx 20rpx 0;
  background: #fff6e3;
}

.tip-mark {
  position: absolute;
  top: 6rpx;
  left: 12rpx;
  color: #e8b877;
  font-family: Georgia, serif;
  font-size: 46rpx;
  line-height: 1;
}

.tip-text {
  color: #8a5a2b;
  font-size: 24rpx;
  line-height: 1.6;
}

.study-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 32rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #43301f, #2f2116);
  box-shadow: 0 14rpx 30rpx rgba(50, 32, 18, 0.28);
}

.study-link-copy {
  display: flex;
  flex-direction: column;
}

.study-link-kicker {
  color: #d8b07a;
  font-family: 'Iowan Old Style', Georgia, serif;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2.6rpx;
}

.study-link-text {
  margin-top: 8rpx;
  color: #ffe9c4;
  font-size: 27rpx;
  font-weight: 700;
}

.study-link-arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid #f4c882;
  border-right: 4rpx solid #f4c882;
  transform: rotate(45deg);
}

/* ---------- 动画 ---------- */
@keyframes breathe {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-6rpx) scale(1.015, 0.985); }
}

@keyframes shadowPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(0.94); opacity: 0.78; }
}

@keyframes blink {
  0%, 42%, 46%, 100% { transform: scaleY(1); }
  44% { transform: scaleY(0.08); }
}

@keyframes tailWag {
  0%, 100% { transform: rotate(-8deg); }
  50% { transform: rotate(16deg); }
}

@keyframes hop {
  0% { transform: translateY(0); }
  35% { transform: translateY(-42rpx) scale(1.02, 0.98); }
  70% { transform: translateY(0) scale(0.98, 1.02); }
  85% { transform: translateY(-10rpx); }
  100% { transform: translateY(0); }
}

@keyframes spin {
  0% { transform: rotate(0) translateY(0); }
  40% { transform: rotate(8deg) translateY(-26rpx); }
  75% { transform: rotate(-6deg) translateY(0); }
  100% { transform: rotate(0); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx) rotate(-2deg); }
  45% { transform: translateX(10rpx) rotate(2deg); }
  70% { transform: translateX(-6rpx); }
}

@keyframes wiggle {
  0%, 100% { transform: rotate(0); }
  30% { transform: rotate(-4deg); }
  65% { transform: rotate(4deg); }
}

@keyframes fishDrop {
  0% { transform: translate(30rpx, -30rpx) rotate(12deg); opacity: 0; }
  30% { opacity: 1; }
  100% { transform: translate(-30rpx, 150rpx) rotate(-18deg); opacity: 0; }
}

@keyframes heartRise {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  25% { opacity: 1; }
  100% { transform: translateY(-70rpx) scale(1); opacity: 0; }
}

@keyframes bubbleUp {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  30% { opacity: 1; }
  100% { transform: translateY(-64rpx) scale(1.1); opacity: 0; }
}

@keyframes zzzFloat {
  0% { transform: translateY(0); opacity: 0; }
  30% { opacity: 1; }
  100% { transform: translateY(-50rpx); opacity: 0; }
}

@keyframes floatDust {
  0%, 100% { transform: translateY(0); opacity: 0.4; }
  50% { transform: translateY(-26rpx); opacity: 0.9; }
}

@keyframes drift {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-16rpx); }
}

@media (prefers-reduced-motion: reduce) {
  .cat,
  .pet-shadow,
  .cat-tail,
  .cat-eye,
  .dust,
  .cloud,
  .fx,
  .state-cat,
  .state-eye {
    animation: none !important;
  }
}
