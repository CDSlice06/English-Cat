.preview-page {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ---------- 加载 / 错误 ---------- */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 120rpx 40rpx 0;
  text-align: center;
}

.state-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.state-text {
  color: var(--faint);
  font-size: 22rpx;
  line-height: 1.7;
}

.error-text {
  color: #a8442a;
  font-size: 23rpx;
  line-height: 1.7;
}

.state-link {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  text-decoration: underline;
}

/* ---------- 顶部说明 ---------- */
.head {
  padding: 10rpx 4rpx 22rpx;
}

.kicker {
  display: block;
  color: var(--faint);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.head-title {
  display: block;
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.head-meta {
  display: block;
  margin-top: 10rpx;
  color: #8a5a0d;
  font-size: 22rpx;
  font-weight: 700;
}

.head-note {
  display: block;
  margin-top: 8rpx;
  color: var(--faint);
  font-size: 20rpx;
  line-height: 1.6;
}

/* ---------- 卡片 ---------- */
.paper-card {
  margin-bottom: 24rpx;
  padding: 26rpx 28rpx;
}

/* 预览首页顶边压一条和纸胶带，像把稿件摊在桌上 */
.preview-tape {
  position: absolute;
  z-index: 3;
  left: 50%;
  top: 0;
  width: 118rpx;
  height: 28rpx;
  margin-left: -59rpx;
  pointer-events: none;
  background: rgba(255, 226, 160, 0.9);
  border-left: 2rpx dashed rgba(116, 72, 40, 0.14);
  border-right: 2rpx dashed rgba(116, 72, 40, 0.14);
  transform: rotate(-3deg);
  transform-origin: left top;
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.card-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.card-hint {
  color: var(--faint);
  font-size: 20rpx;
}

.origin-box {
  max-height: 420rpx;
}

.origin-text {
  display: block;
  color: var(--ink-2);
  font-size: 23rpx;
  line-height: 1.9;
  word-break: break-word;
  text-indent: 2em;
}

.origin-text + .origin-text {
  margin-top: 16rpx;
}

.translation-text {
  display: block;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 1.9;
  text-indent: 2em;
}

.translation-text + .translation-text {
  margin-top: 18rpx;
}

.inline-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 26rpx 0;
}

.inline-text {
  color: var(--faint);
  font-size: 22rpx;
}

.retry-link {
  padding: 8rpx 20rpx;
  border: 2rpx solid rgba(168, 106, 17, 0.34);
  border-radius: 999rpx;
  background: #fff3cf;
  color: #8a5a0d;
  font-size: 20rpx;
  font-weight: 700;
}

/* ---------- 学习目标 ---------- */
.goal-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.goal-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 18rpx 10rpx;
  border: 2rpx dashed rgba(199, 121, 63, 0.30);
  border-radius: 20rpx;
  background: rgba(255, 247, 226, 0.72);
}

.goal-item:nth-child(1) { transform: rotate(-1.2deg); }
.goal-item:nth-child(2) { transform: rotate(0.8deg); }
.goal-item:nth-child(3) { transform: rotate(-0.6deg); }
.goal-item:nth-child(4) { transform: rotate(1deg); }

.goal-count {
  color: #8a5a0d;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.goal-label {
  color: var(--muted);
  font-size: 21rpx;
}

.list-block {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed rgba(199, 121, 63, 0.24);
}

.list-title {
  display: block;
  margin-bottom: 10rpx;
  color: #8a5a0d;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.list-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 9rpx 0;
}

.list-row-block {
  flex-direction: column;
  gap: 4rpx;
}

.list-key {
  flex: none;
  max-width: 45%;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 700;
  word-break: break-word;
}

.list-val {
  flex: 1;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.list-sentence {
  color: var(--faint);
  font-size: 21rpx;
  line-height: 1.7;
  word-break: break-word;
}

/* ---------- 底部操作 ---------- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(253, 247, 234, 0.94);
  border-top: 2rpx solid rgba(116, 72, 40, 0.16);
  backdrop-filter: blur(6rpx);
}

.btn-ghost {
  flex: none;
  padding: 22rpx 34rpx;
  border: 2rpx solid rgba(116, 72, 40, 0.28);
  border-radius: 999rpx;
  background: #fffdf6;
  color: var(--muted);
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

.btn-primary {
  flex: 1;
  padding: 22rpx 34rpx;
  border: 2rpx solid rgba(168, 106, 17, 0.45);
  border-radius: 999rpx;
  background: #ffd479;
  color: #5b3a08;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 3rpx 3rpx 0 rgba(168, 106, 17, 0.18);
}

.btn-primary.is-busy {
  opacity: 0.6;
}
