.overview {
  position: relative;
  overflow: hidden;
  padding: 38rpx 30rpx 30rpx;
  border: 2rpx solid rgba(116, 72, 40, 0.48);
  border-radius: var(--r-lg);
  background: linear-gradient(150deg, #fff9e8 0%, #ffedbd 52%, #ffdc8b 100%);
  box-shadow: var(--shadow-caramel);
}

.overview-tape { top: -5rpx; left: 42rpx; }

.overview-star {
  right: 30rpx;
  bottom: 26rpx;
  width: 18rpx;
  height: 18rpx;
  background: rgba(199, 121, 63, 0.32);
}

.overview-glow {
  position: absolute;
  top: -90rpx;
  right: -40rpx;
  width: 250rpx;
  height: 250rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.52);
}

.overview-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.overview-copy {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.overview-kicker {
  display: block;
  color: #8a5a0d;
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
}

.overview-title {
  display: block;
  margin-top: 10rpx;
  color: #3d2d1c;
  font-size: var(--fs-sub);
  font-weight: 700;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  color: #74571f;
  font-size: var(--fs-note);
}

.overview-meta-strong { font-weight: 700; color: #5c4008; }
.overview-meta-sep { margin: 0 10rpx; opacity: 0.6; }

/* 猫猫装进一张小拍立得，贴在封面右上角 */
.overview-photo {
  position: relative;
  flex-shrink: 0;
  margin: -4rpx 0 0 14rpx;
  padding: 8rpx 8rpx 4rpx;
  border: 2rpx solid rgba(116, 72, 40, 0.30);
  border-radius: var(--r-md);
  background: #fffdf8;
  box-shadow: 5rpx 6rpx 0 rgba(116, 72, 40, 0.14);
  transform: rotate(4deg);
}

.overview-photo-tape {
  position: absolute;
  z-index: 3;
  left: 50%;
  top: -14rpx;
  width: 84rpx;
  height: 26rpx;
  margin-left: -42rpx;
  background: rgba(255, 226, 160, 0.94);
  border-left: 2rpx dashed rgba(116, 72, 40, 0.14);
  border-right: 2rpx dashed rgba(116, 72, 40, 0.14);
  transform: rotate(-5deg);
}

.overview-cat {
  width: 146rpx !important;
  height: 146rpx !important;
}

/* ---------- 四站猫爪路线 ---------- */
.list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 46rpx 4rpx 22rpx;
}

.list-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.list-stamp {
  align-self: flex-start;
  padding: 2rpx 10rpx;
  border: 2rpx solid rgba(168, 106, 17, 0.34);
  border-radius: 6rpx 8rpx 5rpx 7rpx;
  color: var(--amber);
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.4;
  transform: rotate(-3deg);
}

.list-title {
  position: relative;
  font-size: var(--fs-sub);
  font-weight: 700;
}

.list-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -7rpx;
  width: 68rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(255, 210, 92, 0.66);
  transform: rotate(-2deg);
}

.list-hint {
  color: var(--muted);
  font-size: var(--fs-note);
}

.unit-list {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 0 4rpx 10rpx;
}

/* 学习路线：卡片之间的虚线把四个节点串起来 */
.unit + .unit::before {
  content: '';
  position: absolute;
  left: 44rpx;
  top: -24rpx;
  width: 0;
  height: 24rpx;
  border-left: 3rpx dashed rgba(199, 121, 63, 0.34);
  pointer-events: none;
}

.unit {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx 24rpx 18rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: #fffdf8;
  box-shadow: var(--shadow-1);
  transition: transform 0.16s ease, background 0.16s ease, box-shadow 0.16s ease;
}

.unit:nth-child(odd) { transform: rotate(0.35deg); }
.unit:nth-child(even) { transform: rotate(-0.25deg); }

.unit.unit-hover {
  transform: translateY(2rpx) rotate(0deg);
  background: #fff8e8;
  box-shadow: 2rpx 2rpx 0 rgba(103, 73, 40, 0.10);
}

/* 四站同用纸卡，只在序号圆点上区分色相 */
.unit-index {
  position: relative;
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fffdf8;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(75, 64, 52, 0.16), 2rpx 2rpx 0 rgba(116, 72, 40, 0.10);
  font-size: var(--fs-note);
  font-weight: 700;
}

.tone-sun .unit-index { background: #fff0c9; color: #95660f; }
.tone-mint .unit-index { background: #e2f2e6; color: #3f755a; }
.tone-sky .unit-index { background: #e4eef9; color: #3f6b9c; }
.tone-coral .unit-index { background: #ffe7de; color: #b05a3e; }

/* 站点猫猫也做成一张小贴纸 */
.unit-sticker {
  flex-shrink: 0;
  padding: 3rpx;
  border: 2rpx solid rgba(116, 72, 40, 0.20);
  border-radius: var(--r-md);
  background: #fffaf0;
  box-shadow: 3rpx 3rpx 0 rgba(116, 72, 40, 0.10);
  transform: rotate(-3deg);
}

.unit:nth-child(even) .unit-sticker {
  transform: rotate(3deg);
}

.unit-cat {
  width: 82rpx !important;
  height: 82rpx !important;
  flex-shrink: 0;
}

.unit-copy {
  flex: 1;
  min-width: 0;
}

.unit-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.unit-title {
  font-size: var(--fs-sub);
  font-weight: 700;
  color: var(--ink);
}

.status {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border: 2rpx dashed rgba(75, 64, 52, 0.16);
  border-radius: var(--r-pill);
  background: rgba(243, 238, 228, 0.78);
  color: var(--muted);
  font-size: 20rpx;
}

.status-done {
  border: 2rpx solid rgba(95, 168, 124, 0.30);
  background: #e2f2e6;
  color: #3f755a;
  font-weight: 700;
}

.unit-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: var(--fs-note);
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 手绘右箭头：两条边拼出来，不再用 › 字符 */
.unit-arrow {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(75, 64, 52, 0.12);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.66);
}

.unit-arrow::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  margin-left: -4rpx;
  border-top: 2rpx solid #a8957b;
  border-right: 2rpx solid #a8957b;
  border-radius: 0 2rpx 0 0;
  transform: rotate(45deg);
}

/* ---------- 报告便签 ---------- */
.summary-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  /* 和上面「专项训练」拉开，避免被读成同一组 */
  margin-top: 52rpx;
  padding: 30rpx 26rpx 26rpx;
  border: 2rpx dashed rgba(116, 72, 40, 0.26);
  border-radius: var(--r-lg);
  background-color: #fffdf8;
  background-image: repeating-linear-gradient(0deg, rgba(116, 72, 40, 0) 0 39rpx, rgba(116, 72, 40, 0.07) 39rpx 40rpx);
  box-shadow: var(--shadow-paper);
}

.summary-tape { top: -15rpx; left: 36rpx; }

/* 票根式虚线：图标一侧像撕下来的小票存根 */
.summary-entry::before {
  content: '';
  position: absolute;
  left: 127rpx;
  top: 16rpx;
  bottom: 16rpx;
  border-left: 2rpx dashed rgba(116, 72, 40, 0.20);
  pointer-events: none;
}

.summary-ready {
  border: 2rpx solid rgba(199, 121, 63, 0.44);
  background: linear-gradient(135deg, #fff8df 0%, #ffe3a8 100%);
  box-shadow: var(--shadow-caramel);
}

.summary-icon {
  position: relative;
  z-index: 1;
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(75, 64, 52, 0.16);
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 3rpx 4rpx 0 rgba(75, 64, 52, 0.10);
  transform: rotate(-3deg);
}

.summary-copy { position: relative; z-index: 1; flex: 1; min-width: 0; }

.summary-title {
  display: block;
  font-size: var(--fs-sub);
  font-weight: 700;
}

.summary-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--fs-note);
}

/* 手绘长箭头：一条线加箭头，替代 → 字符 */
.summary-arrow {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 40rpx;
  height: 16rpx;
}

.summary-arrow::before {
  content: '';
  position: absolute;
  left: 0;
  right: 2rpx;
  top: 50%;
  height: 2rpx;
  background: #9c8357;
  transform: rotate(-2deg);
}

.summary-arrow::after {
  content: '';
  position: absolute;
  right: 2rpx;
  top: 2rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid #9c8357;
  border-right: 2rpx solid #9c8357;
  border-radius: 0 2rpx 0 0;
  transform: rotate(45deg);
}

.ai-pending {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: #6f6557;
  font-size: 22rpx;
}

.ai-pending-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #c98a3c;
  animation: ai-pulse 1.4s ease-in-out infinite;
}

@keyframes ai-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.15); }
}

/* 精讲失败不用「正在进行」的呼吸点，改成静态提示，避免误以为还在加载 */
.ai-failed .ai-pending-dot {
  animation: none;
  opacity: 1;
  background: #b4552d;
}

@media (prefers-reduced-motion: reduce) {
  .ai-pending-dot { animation: none; opacity: 0.8; }
}

@media (prefers-reduced-motion: reduce) {
  .unit,
  .unit:nth-child(odd),
  .unit:nth-child(even),
  .unit.unit-hover {
    transition: none;
    transform: none;
  }
}

/* ---------- 继续上次（断点续接） ---------- */
.resume-entry {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  margin-top: 22rpx;
  padding: 16rpx 22rpx;
  border: 2rpx dashed rgba(116, 72, 40, 0.42);
  border-radius: var(--r-sm);
  background: rgba(255, 255, 255, 0.66);
}

.resume-entry-hover {
  background: rgba(255, 255, 255, 0.92);
}

.resume-icon {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  /* 与「今日复习」的猫猫对齐：往左上收一点，避免贴住文字 */
  margin: -12rpx 0 0 -10rpx;
}

.resume-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.resume-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--ink);
}

.resume-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.resume-go {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  color: #6b4a12;
  border: 2rpx solid rgba(116, 72, 40, 0.4);
  border-radius: 999rpx;
  background: rgba(255, 226, 160, 0.9);
}

/* ---------- 电子宠物入口 ---------- */
.pet-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(116, 72, 40, 0.36);
  border-radius: var(--r-md);
  background: linear-gradient(135deg, #fff8e8 0%, #ffe9c2 100%);
  box-shadow: 0 10rpx 24rpx rgba(140, 90, 40, 0.1);
}

.pet-entry-hover {
  background: linear-gradient(135deg, #fff3d8 0%, #ffdfa8 100%);
}

.pet-entry-photo {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx dashed rgba(180, 120, 60, 0.4);
}

.pet-entry-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.pet-entry-kicker {
  color: #a97a37;
  font-family: 'Iowan Old Style', Georgia, serif;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2.4rpx;
}

.pet-entry-title {
  margin-top: 4rpx;
  color: #3d2d1c;
  font-size: 28rpx;
  font-weight: 700;
}

.pet-entry-desc {
  margin-top: 4rpx;
  color: #8a6a4d;
  font-size: 21rpx;
}

/* ---------- 真题翻译手账入口 ---------- */
.handbook-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 0;
  padding: 30rpx 26rpx 24rpx;
  border: 2rpx solid rgba(116, 72, 40, 0.34);
  border-radius: var(--r-md);
  background-color: #fffdf8;
  background-image: repeating-linear-gradient(0deg, rgba(116, 72, 40, 0) 0 39rpx, rgba(116, 72, 40, 0.07) 39rpx 40rpx);
  box-shadow: var(--shadow-paper);
}

/* 顶部一小段和纸胶带，和学习页其他卡片同一套贴法 */
.handbook-entry::before {
  content: '';
  position: absolute;
  left: 44rpx;
  top: -13rpx;
  width: 96rpx;
  height: 26rpx;
  background: rgba(255, 226, 160, 0.94);
  border-left: 2rpx dashed rgba(116, 72, 40, 0.14);
  border-right: 2rpx dashed rgba(116, 72, 40, 0.14);
  transform: rotate(-4deg);
}

.handbook-entry-hover {
  background-color: #fff8e8;
  box-shadow: 2rpx 2rpx 0 rgba(103, 73, 40, 0.10);
}

.handbook-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid rgba(75, 64, 52, 0.18);
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 3rpx 4rpx 0 rgba(75, 64, 52, 0.10);
  transform: rotate(-3deg);
}

.handbook-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.handbook-kicker {
  color: var(--amber);
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2.4rpx;
}

.handbook-title {
  color: #3d2d1c;
  font-size: 28rpx;
  font-weight: 700;
}

.handbook-desc {
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}
