/* ---------- 顶部概览 ---------- */
.summary-card {
  position: relative;
  overflow: hidden;
  padding: var(--card-pad-y);
  border: 2rpx solid #241f18;
  border-radius: var(--r-lg);
  background: linear-gradient(150deg, #332d24 0%, #463c2b 60%, #51432c 100%);
  box-shadow: 7rpx 8rpx 0 rgba(199, 121, 63, 0.28);
  --ink: #fff8e9;
  --muted: rgba(255, 244, 219, 0.62);
}

/* 深色速览卡也贴一条和纸胶带，和整站手帐语言一致 */
.summary-card::before {
  content: '';
  position: absolute;
  z-index: 3;
  top: 3rpx;
  left: 30rpx;
  width: 116rpx;
  height: 28rpx;
  pointer-events: none;
  background: rgba(255, 226, 160, 0.92);
  border-left: 2rpx dashed rgba(116, 72, 40, 0.18);
  border-right: 2rpx dashed rgba(116, 72, 40, 0.18);
  transform: rotate(-7deg);
}

.summary-row {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  padding-right: 100rpx;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.summary-num {
  color: #ffd25c;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.1;
}

.summary-label {
  color: rgba(255, 244, 219, 0.66);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.summary-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* 猫猫做成一张白边贴纸，深色卡上更跳 */
.summary-cat {
  position: absolute !important;
  right: 10rpx;
  bottom: 12rpx;
  width: 92rpx !important;
  height: 92rpx !important;
  padding: 5rpx;
  border: 2rpx solid rgba(255, 248, 233, 0.34);
  border-radius: var(--r-md);
  background: #fffdf8;
  box-shadow: 3rpx 4rpx 0 rgba(0, 0, 0, 0.22);
  transform: rotate(5deg);
}

.ai-note {
  display: block;
  margin-top: 14rpx;
  padding-right: 110rpx;
  color: rgba(255, 244, 219, 0.72);
  font-size: 22rpx;
  line-height: 1.5;
}

/* ---------- 语法点卡片 ---------- */
.grammar-card {
  position: relative;
  margin-top: var(--card-gap);
  padding: 26rpx 26rpx 24rpx 34rpx;
  border: 2rpx solid rgba(116, 72, 40, 0.22);
  border-radius: var(--r-md);
  background: linear-gradient(155deg, #fffdf6 0%, #fff8e9 100%);
  box-shadow: var(--shadow-paper);
  transition: box-shadow 0.18s ease;
}

.grammar-card::before {
  content: '';
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 14rpx;
  border-left: 2rpx dashed rgba(199, 121, 63, 0.25);
  pointer-events: none;
}

.card-open {
  border-color: rgba(199, 121, 63, 0.52);
  box-shadow: 7rpx 8rpx 0 rgba(199, 121, 63, 0.16);
}

.grammar-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.grammar-index {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(116, 72, 40, 0.48);
  border-radius: 13rpx 10rpx 14rpx 9rpx;
  background: linear-gradient(135deg, #ffe08a 0%, #f6b83d 100%);
  box-shadow: 3rpx 3rpx 0 rgba(116, 72, 40, 0.16);
  color: #4a3406;
  font-size: 21rpx;
  font-weight: 700;
}

.grammar-title-wrap {
  flex: 1;
  min-width: 0;
}

.grammar-pattern {
  display: block;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.5;
}

.grammar-meta {
  display: block;
  margin-top: 6rpx;
  color: var(--faint);
  font-size: 19rpx;
}

.grammar-toggle {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(168, 106, 17, 0.08);
  color: #8a6a2d;
  font-size: 19rpx;
  font-weight: 700;
}

.grammar-sentence {
  display: block;
  margin-top: 18rpx;
  padding: 18rpx 18rpx 18rpx 22rpx;
  border: 2rpx dashed rgba(199, 121, 63, 0.30);
  border-radius: 16rpx 22rpx 18rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.72);
  background-image: repeating-linear-gradient(
    180deg,
    transparent 0,
    transparent 45rpx,
    rgba(199, 121, 63, 0.08) 45rpx,
    rgba(199, 121, 63, 0.08) 46rpx
  );
  border-left: 6rpx solid rgba(199, 121, 63, 0.62);
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.85;
}

/* ---------- 讲解 ---------- */
.explain {
  margin-top: 20rpx;
}

.explain-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.explain-tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(168, 106, 17, 0.09);
  color: #8a6a2d;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.explain-text {
  display: block;
  color: var(--ink-2);
  font-size: 27rpx;
  line-height: 1.85;
}

/* ---------- 分步理解 ---------- */
.step-list {
  margin-top: 12rpx;
  padding: 8rpx 16rpx 8rpx 14rpx;
  border: 2rpx dashed rgba(199, 121, 63, 0.26);
  border-radius: 16rpx 22rpx 18rpx 20rpx;
  background: rgba(255, 251, 240, 0.86);
}

.step-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 13rpx 0;
  border-top: 1rpx dashed rgba(199, 121, 63, 0.18);
}

.step-row:first-child {
  border-top: none;
  padding-top: 10rpx;
}

.step-index {
  flex: none;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(116, 72, 40, 0.32);
  border-radius: 10rpx 8rpx 11rpx 7rpx;
  background: #fff3cf;
  color: #8a5a0d;
  font-size: 19rpx;
  font-weight: 700;
}

.step-body {
  flex: 1;
  min-width: 0;
}

.step-title {
  display: block;
  color: #6f4a15;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.55;
}

.step-detail {
  display: block;
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 1.8;
}

/* ---------- 分块翻译 ---------- */
.chunk-list {
  margin-bottom: 12rpx;
  padding: 12rpx 16rpx;
  border: 2rpx dashed rgba(111, 145, 173, 0.30);
  border-radius: 16rpx 22rpx 18rpx 20rpx;
  background: rgba(241, 247, 251, 0.72);
}

.chunk-row {
  padding: 9rpx 0;
  border-top: 1rpx dashed rgba(111, 145, 173, 0.22);
}

.chunk-row:first-child {
  border-top: none;
  padding-top: 2rpx;
}

.chunk-en {
  display: block;
  color: #3f5c74;
  font-size: 25rpx;
  line-height: 1.75;
}

.chunk-arrow {
  display: block;
  margin: 2rpx 0;
  color: rgba(111, 145, 173, 0.66);
  font-size: 20rpx;
  line-height: 1.2;
}

.chunk-zh {
  display: block;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 1.75;
}

.chunk-label {
  display: block;
  margin-top: 10rpx;
  padding-top: 9rpx;
  border-top: 1rpx solid rgba(111, 145, 173, 0.24);
  color: var(--faint);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.example-box {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(150deg, #fff8e6 0%, #ffefc8 100%);
}

.example-label {
  display: block;
  margin-bottom: 10rpx;
  color: #8a5a0d;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.example-row {
  padding: 10rpx 0;
  border-top: 1rpx solid rgba(227, 165, 44, 0.22);
}

.example-row:first-child {
  border-top: none;
  padding-top: 0;
}

.example-en {
  display: block;
  color: #4a3a16;
  font-size: 25rpx;
  line-height: 1.7;
}

.example-zh {
  display: block;
  margin-top: 4rpx;
  color: #8a7340;
  font-size: 23rpx;
  line-height: 1.65;
}

.drill-note {
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #f4f0e6;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.7;
}

.grammar-foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(199, 121, 63, 0.22);
}

.grammar-save {
  padding: 7rpx 18rpx;
  border: 2rpx solid rgba(199, 121, 63, 0.18);
  border-radius: 14rpx 18rpx 12rpx 16rpx;
  background: #fff0c9;
  color: #8a5a0d;
  font-size: 20rpx;
  font-weight: 700;
}

.grammar-save.save-done {
  border-color: rgba(95, 168, 124, 0.22);
  background: #e8f4e9;
  color: #3d7a58;
}

.empty-analysis {
  margin-top: 24rpx;
  padding: 60rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border-radius: var(--r-lg);
  background: var(--paper);
  border: 2rpx solid var(--line);
  color: var(--muted);
  font-size: 23rpx;
  text-align: center;
}

/* ---------- 底部副操作 ---------- */
.bar-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 88rpx;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--fs-note);
}

.bar-arrow {
  width: 13rpx;
  height: 13rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  border-radius: 0 2rpx 0 0;
  transform: rotate(45deg);
}

@media (prefers-reduced-motion: reduce) {
  .grammar-card { transition: none; }
}
