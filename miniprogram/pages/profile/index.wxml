<view class="page profile tab-page">
  <view wx:if="{{loading}}" class="loading">
    <cat-image custom-class="state-cat" name="sleepy-nap" size="large" />
    <text>正在读取云端记录…</text>
  </view>
  <view wx:elif="{{error}}" class="error-box">
    <cat-image custom-class="state-cat" name="not-found" size="large" />
    <text class="error-text">{{error}}</text>
    <primary-button text="重新连接" bind:tap="load" />
  </view>
  <block wx:else>
    <section-title eyebrow="MY SPACE" title="我的精读喵" />

    <view class="id-card enter d1">
      <view class="id-glow"></view>
      <view class="id-tape"></view>
      <view class="paper-star id-star"></view>
      <view class="id-photo">
        <cat-image custom-class="id-cat" name="pass-check" size="medium" />
      </view>
      <view class="id-copy">
        <text class="id-kicker">DEEP READER</text>
        <text class="id-name">深度阅读学习者</text>
        <text class="id-goal">目标：吃透每一篇四级 / 六级文章</text>
      </view>
      <view class="id-badge">CET 4 / 6</view>
    </view>

    <view class="stat-grid enter d2">
      <view class="stat-card stat-link tone-sun" hover-class="stat-hover" bindtap="goKnownWords">
        <text class="stat-value en">{{book.known}}</text>
        <text class="stat-label">已掌握词汇</text>
      </view>
      <view class="stat-card stat-link tone-mint" hover-class="stat-hover" bindtap="goDrills">
        <text class="stat-value en">{{overview.passedDrills}}</text>
        <text class="stat-label">累计通过题数</text>
      </view>
      <view class="stat-card stat-link tone-sky" hover-class="stat-hover" bindtap="goLibrary">
        <text class="stat-value en">{{overview.masteredArticles}}<text class="stat-unit">篇</text></text>
        <text class="stat-label">掌握篇数</text>
      </view>
    </view>

    <view wx:if="{{reviewEntry.visible}}" class="recite-entry review-entry enter d2" hover-class="recite-entry-hover" bindtap="goReview">
      <view class="recite-entry-copy">
        <text class="recite-entry-kicker">TODAY'S REVIEW</text>
        <text class="recite-entry-title">今日复习</text>
        <text class="recite-entry-sub">{{reviewEntry.meta}}</text>
      </view>
      <text class="entry-badge review-badge">{{reviewEntry.action}}</text>
    </view>

    <view class="recite-entry enter d2" hover-class="recite-entry-hover" bindtap="goRecite">
      <view class="recite-entry-copy">
        <text class="recite-entry-kicker">DAILY RECITE</text>
        <text class="recite-entry-title">今日背诵</text>
        <text class="recite-entry-sub">单词、词组选义拼写，练对转「记得」</text>
      </view>
      <text class="entry-badge recite-badge">去背诵</text>
    </view>

    <view class="notebook-list enter d3">
      <view class="shelf-card shelf-wordbook" bind:tap="goWordbook">
        <view class="shelf-glow"></view>
        <view class="shelf-tape"></view>
        <view class="shelf-sticker">
          <cat-image custom-class="shelf-cat" name="import-book" size="medium" />
        </view>
        <view class="shelf-copy">
          <text class="shelf-kicker">MY WORDBOOK</text>
          <text class="shelf-title">我的生词本</text>
          <view class="shelf-split">
            <view class="split-item">
              <view class="dot dot-warn"></view>
              <text>不记得 {{book.unknown}}</text>
            </view>
            <view class="split-item">
              <view class="dot dot-ok"></view>
              <text>记得 {{book.known}}</text>
            </view>
          </view>
        </view>
        <view class="shelf-enter"></view>
      </view>

      <view class="shelf-card shelf-phrasebook" bind:tap="goPhrasebook">
        <view class="shelf-glow"></view>
        <view class="shelf-tape"></view>
        <view class="shelf-sticker">
          <cat-image custom-class="shelf-cat" name="reading-highlight" size="medium" />
        </view>
        <view class="shelf-copy">
          <text class="shelf-kicker">MY PHRASEBOOK</text>
          <text class="shelf-title">我的词组本</text>
          <view class="shelf-split">
            <view class="split-item">
              <view class="dot dot-warn"></view>
              <text>不记得 {{phraseBook.unknown}}</text>
            </view>
            <view class="split-item">
              <view class="dot dot-ok"></view>
              <text>记得 {{phraseBook.known}}</text>
            </view>
          </view>
        </view>
        <view class="shelf-enter"></view>
      </view>

      <view class="shelf-card shelf-grammarbook" bind:tap="goGrammarbook">
        <view class="shelf-glow"></view>
        <view class="shelf-tape"></view>
        <view class="shelf-sticker">
          <cat-image custom-class="shelf-cat" name="idea-bulb" size="medium" />
        </view>
        <view class="shelf-copy">
          <text class="shelf-kicker">MY GRAMMAR BOOK</text>
          <text class="shelf-title">我的语法与句式本</text>
          <view class="shelf-split">
            <view class="split-item">
              <view class="dot dot-coral"></view>
              <text>已收藏 {{grammarBook.total}} 张</text>
            </view>
            <view wx:if="{{grammarBook.articles}}" class="split-item">
              <view class="dot dot-neutral"></view>
              <text>来自 {{grammarBook.articles}} 篇</text>
            </view>
          </view>
        </view>
        <view class="shelf-enter"></view>
      </view>
    </view>

    <view class="settings enter d4">
      <view class="paper-tape settings-tape"></view>
      <view class="paw-print settings-paw"></view>
      <view class="settings-head">
        <text class="settings-stamp en">SETTINGS</text>
        <text class="settings-title">设置</text>
      </view>
      <view wx:if="{{remind.available}}" class="setting-row" hover-class="setting-hover" bindtap="toggleRemind">
        <text class="setting-label">学习提醒</text>
        <view class="setting-side">
          <text class="setting-value {{remind.enabled ? 'setting-value-on' : ''}}">{{remind.busy ? '处理中…' : (remind.enabled ? '已预约 1 次' : '未开启')}}</text>
          <view class="setting-arrow"></view>
        </view>
      </view>
      <view class="setting-row" hover-class="setting-hover" bindtap="openAbout">
        <text class="setting-label">关于与隐私</text>
        <view class="setting-arrow"></view>
      </view>
      <view class="setting-row setting-hit-row">
        <text class="setting-label">意见反馈</text>
        <view class="setting-arrow"></view>
        <button class="setting-hit" open-type="feedback" aria-label="意见反馈"></button>
      </view>
    </view>

    <view class="settings settings-danger-card enter d4">
      <view class="setting-row" hover-class="setting-hover" bindtap="reset">
        <text class="setting-label setting-label-danger">{{resetting ? '正在清除…' : '清除本篇学习记录'}}</text>
      </view>
    </view>

    <text class="version">英语精读喵 v{{version}}</text>
  </block>
</view>
