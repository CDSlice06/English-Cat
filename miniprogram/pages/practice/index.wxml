<view class="page has-bar practice-page">
  <view wx:if="{{loading}}" class="loading">
    <cat-image custom-class="state-cat" name="sleepy-nap" size="large" />
    <text>正在整理语法练习…</text>
  </view>
  <view wx:elif="{{error}}" class="error-box">
    <cat-image custom-class="state-cat" name="not-found" size="large" />
    <text class="error-text">{{error}}</text>
    <primary-button text="重新连接" bind:tap="load" />
  </view>
  <block wx:elif="{{!items.length}}">
    <section-title eyebrow="STEP 06 · OUTPUT" title="读懂，也要写出来" description="每个语法点配一道英译汉，写完用手机打字提交。" />
    <view class="empty-analysis">
      <cat-image name="sleepy-nap" size="medium" />
      <text>练习还没出题，先去语法页把句型过一遍。</text>
    </view>
  </block>
  <block wx:else>
    <section-title eyebrow="STEP 06 · OUTPUT" title="输出练习，把语法用出来" description="给出英文句子，用中文写出整句意思；系统检查关键表达是否到位。" />

    <view class="report-row">
      <view class="report-link" bind:tap="goSummary">
        <text>本篇学习报告</text>
        <view class="report-link-arrow"></view>
      </view>
    </view>

    <scroll-view class="question-tabs enter d1" scroll-x enable-flex>
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="question-tab {{itemIndex === index ? 'tab-on' : ''}} {{item.passed ? 'tab-passed' : ''}}"
        data-index="{{itemIndex}}"
        bindtap="selectQuestion"
        wx:for-index="itemIndex"
      >
        <text class="tab-num en">{{itemIndex + 1}}</text>
        <text class="tab-label">{{item.shortMode}}</text>
        <view wx:if="{{item.passed}}" class="tab-check"></view>
      </view>
    </scroll-view>

    <view class="practice-card enter d2">
      <view class="card-top">
        <text class="mode">{{item.modeLabel}}</text>
        <text class="keyword-count">句型要点 {{item.keywords.length}} 处</text>
      </view>

      <text class="pattern-chip">{{item.pattern}}</text>
      <text class="prompt {{item.mode === 'en2zh' ? 'en' : ''}}">{{item.prompt}}</text>

      <view class="answer-tools">
        <view class="hint-trigger" bindtap="toggleHint">
          <text>{{showHint ? '收起提示' : '需要提示？'}}</text>
        </view>
      </view>

      <textarea
        class="answer"
        value="{{answer}}"
        disabled="{{evaluating}}"
        placeholder="{{item.mode === 'en2zh' ? '用自然、完整的中文写下这句话的意思…' : '用英语写出完整句子，注意用上这个句型…'}}"
        id="answer-input"
        maxlength="500"
        cursor-spacing="24"
        adjust-position="{{false}}"
        placeholder-class="textarea-placeholder"
        bindinput="onAnswerInput"
        bindfocus="onAnswerFocus"
        bindkeyboardheightchange="onKeyboard"
      />

      <view class="answer-meta">
        <text>{{answerLength}}/500</text>
      </view>

      <!-- 键盘弹起时底栏会让位，改成紧贴输入框的提交入口，不用先收键盘 -->
      <view wx:if="{{keyboardUp}}" class="inline-submit">
        <primary-button text="{{primaryText}}" disabled="{{evaluating || !item.id}}" bind:tap="primaryAction" />
      </view>

      <view wx:if="{{evaluating}}" class="evaluating">
        <cat-image name="sleepy-nap" size="small" />
        <view class="evaluating-body">
          <text class="evaluating-title">{{retrying ? '网络有点慢，正在自动重试…' : '正在逐句评估…'}}</text>
          <text class="evaluating-desc">{{retrying ? '刚才那次评估超时了，不用再点，重试马上出结果。' : '比对整句的结构与用词，通常需要几秒。'}}</text>
        </view>
        <view class="evaluating-dots">
          <view class="evaluating-dot"></view>
          <view class="evaluating-dot"></view>
          <view class="evaluating-dot"></view>
        </view>
      </view>

      <view wx:if="{{showHint}}" class="hint">
        <cat-image name="idea-bulb" size="small" />
        <text class="hint-text">{{item.hint}}</text>
      </view>

      <view wx:if="{{record}}" class="feedback {{record.result}}">
        <view class="feedback-head">
          <view class="feedback-dot"></view>
          <text class="feedback-title">{{record.result === 'pass' ? '回答通过' : (record.result === 'fail' ? '再完善一下' : '暂未判定')}}</text>
        </view>
        <text class="feedback-text">{{record.feedback}}</text>
        <view wx:if="{{record.checklist.length}}" class="feedback-check">
          <text class="feedback-check-label">逐点核对</text>
          <view
            wx:for="{{record.checklist}}"
            wx:for-item="check"
            wx:key="index"
            class="feedback-check-item {{check.ok ? '' : 'check-item-miss'}}"
          >
            <view class="check-mark {{check.ok ? 'check-ok' : 'check-miss'}}"></view>
            <view class="check-body">
              <text class="check-zh">{{check.zh}}</text>
              <text wx:if="{{check.note}}" class="check-note">{{check.note}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{record.tip || record.usage}}" class="feedback-tip">
          <text class="feedback-tip-label">正确用法</text>
          <block wx:if="{{record.usage}}">
            <text wx:if="{{record.usage.point}}" class="feedback-tip-text">{{record.usage.point}}</text>
            <view wx:if="{{record.usage.wrong || record.usage.correct}}" class="feedback-tip-fix">
              <text wx:if="{{record.usage.wrong}}" class="feedback-tip-wrong">你写的：{{record.usage.wrong}}</text>
              <text wx:if="{{record.usage.correct}}" class="feedback-tip-right">这样写：{{record.usage.correct}}</text>
            </view>
            <text wx:if="{{record.usage.example}}" class="feedback-tip-example">例句：{{record.usage.example}}{{record.usage.exampleZh ? '（' + record.usage.exampleZh + '）' : ''}}</text>
          </block>
          <text wx:else class="feedback-tip-text">{{record.tip}}</text>
        </view>
        <view wx:if="{{record.improvements.length}}" class="feedback-improve">
          <text class="feedback-improve-label">可以写得更好</text>
          <view wx:for="{{record.improvements}}" wx:key="index" class="feedback-improve-item">
            <view class="feedback-improve-fix">
              <text class="improve-wrong">{{item.wrong}}</text>
              <text class="improve-arrow">→</text>
              <text class="improve-right">{{item.correct}}</text>
            </view>
            <text class="feedback-improve-point">{{item.point}}</text>
          </view>
        </view>
        <view wx:if="{{rewriteHint}}" class="rewrite-hint">
          <text>{{rewriteHint}}</text>
        </view>
      </view>

      <view wx:if="{{record}}" class="reference-toggle {{referenceLocked ? 'reference-locked' : ''}}" bind:tap="toggleReference">
        <text>{{referenceLocked ? '参考答案已锁定 · 先按讲解重写' : (showReference ? '隐藏参考答案' : '查看参考答案')}}</text>
      </view>

      <view wx:if="{{showReference}}" class="reference">
        <text class="reference-label">参考答案</text>
        <text class="reference-text">{{item.reference}}</text>
      </view>
    </view>

    <text class="demo-text">判定看整句意思与关键表达，不会直接写出参考答案；反馈里附「正确用法」，照着改一遍更有效。</text>

    <next-station
      id="next-station"
      visible="{{nextReady}}"
      title="输出练习全部通过"
      desc="四站都走完了：词、词组、语法、输出。去看看这篇的完整学习报告吧。"
      next-name="本篇学习报告"
      step="DEEP READING REPORT"
      cat="complete-halo"
      action-text="查看学习报告"
      bind:next="goSummary"
    />
  </block>

  <view class="action-bar {{keyboardUp ? 'bar-up' : ''}}">
    <view class="action-meta">
      <text class="action-meta-strong">练习 {{index + 1}} / {{items.length}}</text>
      <text>{{passed}} 道已通过</text>
    </view>
    <primary-button
      text="{{primaryText}}"
      disabled="{{evaluating || !item.id}}"
      bind:tap="primaryAction"
    />
    <view class="bar-nav">
      <view class="bar-nav-item {{index === 0 ? 'nav-disabled' : ''}}" data-index="{{index - 1}}" data-sound="1" bindtap="selectQuestion">
        <view class="nav-arrow nav-arrow-left"></view>
        <text>上一题</text>
      </view>
      <view class="bar-nav-item {{index === items.length - 1 ? 'nav-disabled' : ''}}" data-index="{{index + 1}}" data-sound="1" bindtap="selectQuestion">
        <text>跳过这一题</text>
        <view class="nav-arrow nav-arrow-right"></view>
      </view>
    </view>
  </view>
</view>
