/* ---------- 题库 ---------- */
.library {
  padding-bottom: 60rpx;
}

.lib-hero {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  margin-bottom: var(--card-gap);
  border-radius: var(--r-lg) var(--r-md) var(--r-lg) var(--r-md);
  border: 2rpx solid var(--paper-line);
  background: var(--paper);
  box-shadow: var(--shadow-paper);
}

/* 书架卡顶边的和纸胶带与角标印章 */
.lib-hero-tape {
  left: 132rpx;
  top: 2rpx;
  width: 100rpx;
  height: 26rpx;
  background: rgba(206, 229, 248, 0.86);
  transform: rotate(-5deg);
}

.lib-hero-star {
  right: 26rpx;
  bottom: 18rpx;
  background: rgba(199, 121, 63, 0.2);
}

.lib-stamp {
  position: absolute;
  right: 20rpx;
  top: 16rpx;
  padding: 2rpx 10rpx;
  border: 2rpx solid rgba(168, 106, 17, 0.32);
  border-radius: 6rpx 8rpx 5rpx 7rpx;
  color: var(--amber);
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.5;
  transform: rotate(4deg);
}

/* 猫猫贴成白卡相框，和首页拍立得同一套做法 */
.lib-photo {
  position: relative;
  flex: 0 0 auto;
  padding: 7rpx 7rpx 5rpx;
  border: 2rpx solid rgba(116, 72, 40, 0.24);
  border-radius: var(--r-md);
  background: #fffdf8;
  box-shadow: 4rpx 5rpx 0 rgba(116, 72, 40, 0.14);
  transform: rotate(-4deg);
}

.lib-cat {
  display: block;
  width: 128rpx !important;
  height: 128rpx !important;
}

.lib-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.lib-tag {
  color: var(--amber);
  font-size: var(--fs-note);
  letter-spacing: 2rpx;
}

.lib-title {
  color: var(--ink);
  font-size: var(--fs-sub);
  font-weight: 700;
}

.lib-sub {
  color: var(--muted);
  font-size: var(--fs-note);
  line-height: 1.5;
}

/* ---------- 等级切换 ---------- */
.segmented {
  display: flex;
  gap: 12rpx;
  padding: 8rpx;
  margin-bottom: var(--card-gap);
  border-radius: var(--r-pill);
  border: 2rpx solid var(--paper-line);
  background: rgba(255, 253, 249, 0.72);
}

.seg {
  flex: 1;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  color: var(--muted);
  font-size: var(--fs-body);
  font-weight: 700;
}

.seg-on {
  background: var(--butter);
  color: #3a2a09;
}

/* ---------- 来源切换：内置模拟篇 / 真题库 / 我的导入 ---------- */
.source-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: var(--card-gap);
}

.source-tab {
  flex: 1;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4rpx;
  border-radius: var(--r-md);
  border: 2rpx solid var(--paper-line);
  background: rgba(255, 253, 249, 0.7);
  color: var(--muted);
  font-size: var(--fs-note);
  font-weight: 700;
}

.source-on {
  border-color: rgba(168, 106, 17, 0.5);
  background: var(--amber-soft);
  color: var(--amber);
  box-shadow: 2rpx 3rpx 0 rgba(168, 106, 17, 0.16);
  transform: rotate(-1deg);
}

/* ---------- 年份书签筛选 ---------- */
.year-bar {
  display: flex;
  width: 100%;
  gap: 10rpx;
  padding: 4rpx 2rpx 16rpx;
  white-space: nowrap;
}

.year-chip {
  flex: 0 0 auto;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 26rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid var(--paper-line);
  background: rgba(255, 253, 249, 0.72);
  color: var(--muted);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: var(--fs-note);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.year-chip-num {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--faint);
}

.year-chip-on {
  border-color: rgba(168, 106, 17, 0.5);
  background: var(--butter);
  color: #3a2a09;
  box-shadow: 2rpx 3rpx 0 rgba(168, 106, 17, 0.16);
  transform: rotate(-1.2deg);
}

.year-chip-on .year-chip-num {
  color: #7a5514;
}

/* ---------- 按年份分组 ---------- */
.year-groups {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.year-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* 年份标题：衬线大字 + 虚线延伸 + 篇数，像手帐里的索引标签 */
.year-head {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 2rpx 6rpx 0;
}

.year-head-year {
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.year-head-unit {
  color: var(--muted);
  font-size: var(--fs-note);
}

.year-head-rule {
  flex: 1;
  height: 2rpx;
  margin: 0 10rpx;
  background: repeating-linear-gradient(90deg, rgba(168, 106, 17, 0.26) 0 10rpx, transparent 10rpx 18rpx);
}

.year-head-count {
  color: var(--faint);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* ---------- 随机抽一篇 ---------- */
.draw-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 132rpx;
  padding: 22rpx 26rpx;
  margin-bottom: var(--card-gap);
  border-radius: var(--r-lg) var(--r-md) var(--r-lg) var(--r-md);
  border: 2rpx solid rgba(168, 106, 17, 0.42);
  background: var(--amber-soft);
  box-shadow: var(--shadow-paper);
}

/* 抽签卡顶边压一条胶带，像手帐里贴的便签 */
.lib-draw-tape {
  position: absolute;
  left: 50%;
  top: -12rpx;
  width: 116rpx;
  height: 28rpx;
  margin-left: -58rpx;
  pointer-events: none;
  background: rgba(255, 226, 160, 0.94);
  border-left: 2rpx dashed rgba(116, 72, 40, 0.14);
  border-right: 2rpx dashed rgba(116, 72, 40, 0.14);
  transform: rotate(-3deg);
}

.draw-card-hover {
  transform: translateY(2rpx);
  background: #ffeec2;
}

.draw-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.draw-title {
  color: var(--ink);
  font-size: var(--fs-sub);
  font-weight: 700;
}

.draw-desc {
  color: var(--muted);
  font-size: var(--fs-note);
}

/* 手绘骰子：外框 + 五点面。
   之前只有三个点，且右上那个点超出内框被裁掉，看起来像「更多」菜单的省略号 */
.draw-dice {
  flex: 0 0 auto;
  box-sizing: border-box;
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid var(--amber);
  border-radius: 10rpx;
  background:
    radial-gradient(circle, var(--amber) 0, var(--amber) 3.5rpx, transparent 4.5rpx) 6rpx 6rpx / 10rpx 10rpx no-repeat,
    radial-gradient(circle, var(--amber) 0, var(--amber) 3.5rpx, transparent 4.5rpx) 30rpx 6rpx / 10rpx 10rpx no-repeat,
    radial-gradient(circle, var(--amber) 0, var(--amber) 3.5rpx, transparent 4.5rpx) 18rpx 18rpx / 10rpx 10rpx no-repeat,
    radial-gradient(circle, var(--amber) 0, var(--amber) 3.5rpx, transparent 4.5rpx) 6rpx 30rpx / 10rpx 10rpx no-repeat,
    radial-gradient(circle, var(--amber) 0, var(--amber) 3.5rpx, transparent 4.5rpx) 30rpx 30rpx / 10rpx 10rpx no-repeat;
}

/* ---------- 文章列表 ---------- */
.lib-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.lib-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 128rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  border: 2rpx solid var(--paper-line);
  background: var(--paper);
}

.lib-item-hover {
  background: #fff8e8;
  transform: translateY(2rpx);
}

/* 序号做成手写编号章：虚线圆圈 + 衬线数字 */
.lib-index {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(168, 106, 17, 0.34);
  border-radius: 50%;
  color: var(--amber);
  font-size: 24rpx;
  font-weight: 700;
}

.lib-item-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 标题行：标题 + 「已学完 / 学了 x%」标记，标题过长时标记换行不挤压 */
.lib-item-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.lib-progress {
  flex: 0 0 auto;
  padding: 2rpx 10rpx;
  border-radius: var(--r-pill);
  border: 2rpx dashed rgba(168, 106, 17, 0.4);
  background: var(--amber-soft);
  color: var(--amber);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  line-height: 1.5;
}

/* 学完的用实线绿章，和进行中的虚线圈区分开 */
.lib-progress-done {
  border-style: solid;
  border-color: rgba(95, 168, 124, 0.55);
  background: var(--mint-soft);
  color: var(--mint);
}

.lib-item-title {
  color: var(--ink);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1.4;
}

/* 真题库标题来自正文首句，可能很长，列表里最多显示两行 */
.lib-item-title-clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.lib-item-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--faint);
  font-size: var(--fs-note);
}

.lib-issue {
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid rgba(168, 106, 17, 0.34);
  background: var(--amber-soft);
  color: var(--amber);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.lib-words {
  letter-spacing: 1rpx;
}

/* ---------- 空态 ---------- */
/* 导入入口做成一眼能看出可点的按钮卡：实线描边 + 错位硬影 + 胶囊 CTA */
.lib-import-tip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 96rpx;
  margin-top: 16rpx;
  padding: 18rpx 22rpx 18rpx 24rpx;
  border-radius: var(--r-md);
  border: 2rpx solid rgba(168, 106, 17, 0.42);
  background: rgba(255, 253, 249, 0.92);
  box-shadow: 4rpx 4rpx 0 rgba(168, 106, 17, 0.18), 0 2rpx 8rpx rgba(43, 25, 12, 0.05);
}

.lib-import-hover {
  transform: translateY(2rpx);
  background: #fff6dd;
  box-shadow: 2rpx 2rpx 0 rgba(168, 106, 17, 0.16);
}

/* 胶囊 CTA：把「这里能点」写明白，不再只靠一个小箭头 */
.lib-import-cta {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid rgba(168, 106, 17, 0.42);
  background: var(--butter);
  color: #3a2a09;
  font-size: var(--fs-note);
  font-weight: 700;
}

.lib-import-cta .lib-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top-color: var(--amber);
  border-right-color: var(--amber);
}

.lib-import-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.lib-import-title {
  color: var(--amber);
  font-size: var(--fs-note);
  font-weight: 700;
}

.lib-import-desc {
  color: var(--faint);
  font-size: var(--fs-note);
  line-height: 1.5;
}

.lib-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 34rpx 30rpx 38rpx;
  border-radius: var(--r-lg) var(--r-md) var(--r-lg) var(--r-md);
  border: 2rpx dashed rgba(168, 106, 17, 0.28);
  background: rgba(255, 253, 249, 0.72);
}

.lib-empty text {
  color: var(--muted);
  font-size: var(--fs-note);
  line-height: 1.6;
  text-align: center;
}

.lib-empty-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
  padding: 0 40rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid rgba(168, 106, 17, 0.42);
  background: var(--butter);
  color: #3a2a09;
  font-size: var(--fs-body);
  font-weight: 700;
}

.lib-arrow {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--faint);
  border-right: 3rpx solid var(--faint);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.lib-note {
  margin-top: var(--card-gap);
  padding: 18rpx 22rpx;
  border-radius: var(--r-md);
  border: 2rpx dashed rgba(168, 106, 17, 0.24);
  background: rgba(255, 253, 249, 0.7);
}

.lib-note text {
  color: var(--faint);
  font-size: var(--fs-note);
  line-height: 1.7;
}

.lib-error {
  margin-bottom: var(--card-gap);
  padding: 18rpx 22rpx;
  border-radius: var(--r-md);
  border: 2rpx solid rgba(239, 131, 104, 0.45);
  background: var(--coral-soft);
  color: #a4402a;
  font-size: var(--fs-note);
  line-height: 1.6;
}

/* ---------- 抽取中 ---------- */
.lib-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(36, 31, 24, 0.32);
}

.lib-mask-card {
  width: 480rpx;
  padding: 30rpx 26rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border-radius: var(--r-lg) var(--r-md) var(--r-lg) var(--r-md);
  border: 2rpx solid var(--paper-line);
  background: var(--paper);
  box-shadow: var(--shadow-paper);
}

.lib-mask-title {
  color: var(--ink);
  font-size: var(--fs-body);
  font-weight: 700;
}

.lib-mask-text {
  color: var(--muted);
  font-size: var(--fs-note);
  text-align: center;
  line-height: 1.5;
}
