<view class="page library">
  <view class="lib-hero enter">
    <view class="paper-tape lib-hero-tape"></view>
    <view class="paper-star lib-hero-star"></view>
    <view class="lib-stamp en">SHELF</view>
    <view class="lib-photo">
      <cat-image name="reading-highlight" size="medium" custom-class="lib-cat" />
    </view>
    <view class="lib-copy">
      <view class="lib-tag en">LIBRARY · 分级题库</view>
      <text class="lib-title">今天读哪篇</text>
      <text class="lib-sub">内置 2013–2026 四六级真题与模拟篇，翻开就能精读；也支持自己导入文章</text>
    </view>
  </view>

  <view class="segmented enter d1">
    <view
      wx:for="{{levels}}"
      wx:key="key"
      class="seg {{level === item.key ? 'seg-on' : ''}}"
      bind:tap="switchLevel"
      data-level="{{item.key}}"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="source-tabs enter d1">
    <view class="source-tab {{source === 'bank' ? 'source-on' : ''}}" bind:tap="switchSource" data-source="bank">
      <text>内置模拟篇</text>
    </view>
    <view class="source-tab {{source === 'exams' ? 'source-on' : ''}}" bind:tap="switchSource" data-source="exams">
      <text>真题库</text>
    </view>
    <view class="source-tab {{source === 'imported' ? 'source-on' : ''}}" bind:tap="switchSource" data-source="imported">
      <text>我的导入{{imported.length ? '(' + imported.length + ')' : ''}}</text>
    </view>
  </view>

  <view class="draw-card enter d2" hover-class="draw-card-hover" bind:tap="draw">
    <view class="lib-draw-tape"></view>
    <view class="draw-copy">
      <text class="draw-title">随机抽一篇</text>
      <text class="draw-desc">{{source === 'bank' ? '猫随手翻一页，抽到哪篇读哪篇' : source === 'exams' ? '从内置真题库里随机抽一篇仔细阅读' : '从你导入的文章里随机抽一篇'}}</text>
    </view>
    <view class="draw-dice"></view>
  </view>

  <view wx:if="{{error}}" class="lib-error enter">{{error}}</view>

  <block wx:if="{{source === 'bank'}}">
    <view class="lib-list">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="lib-item enter"
        hover-class="lib-item-hover"
        bind:tap="pick"
        data-id="{{item.id}}"
      >
        <view class="lib-index en">{{index + 1}}</view>
        <view class="lib-item-copy">
          <text class="lib-item-title">{{item.title}}</text>
          <view class="lib-item-meta">
            <text class="lib-issue">{{item.issueLabel}}</text>
            <text class="lib-dot">·</text>
            <text class="lib-topic">{{item.topic}}</text>
            <text class="lib-dot">·</text>
            <text class="lib-words en">{{item.words}} words</text>
          </view>
        </view>
        <view class="lib-arrow"></view>
      </view>
    </view>
    <view class="lib-import-tip" hover-class="lib-import-hover" hover-stay-time="80" bind:tap="goImport">
      <view class="lib-import-copy">
        <text class="lib-import-title">手里有真题原文？</text>
        <text class="lib-import-desc">粘贴或上传 Word / PDF，导入后收进「我的导入」，随时打开精读</text>
      </view>
      <view class="lib-import-cta">
        <text>去导入</text>
        <view class="lib-arrow"></view>
      </view>
    </view>
  </block>

  <block wx:elif="{{source === 'exams'}}">
    <!-- 内置真题库：年份书签先收窄，再按年份分组挑篇目 -->
    <scroll-view wx:if="{{examYears.length > 2}}" class="year-bar enter d1" scroll-x enable-flex>
      <view
        wx:for="{{examYears}}"
        wx:key="key"
        class="year-chip {{examYearFilter === item.key ? 'year-chip-on' : ''}}"
        bind:tap="pickExamYear"
        data-key="{{item.key}}"
      >
        <text>{{item.label}}</text>
        <text class="year-chip-num en">{{item.count}}</text>
      </view>
    </scroll-view>

    <view wx:if="{{examGroups.length}}" class="year-groups">
      <view wx:for="{{examGroups}}" wx:key="key" wx:for-item="group" class="year-group">
        <view class="year-head">
          <text class="year-head-year en">{{group.yearLabel}}</text>
          <text wx:if="{{group.year}}" class="year-head-unit">年</text>
          <view class="year-head-rule"></view>
          <text class="year-head-count">{{group.count}} 篇</text>
        </view>
        <view class="lib-list">
          <view
            wx:for="{{group.items}}"
            wx:key="id"
            wx:for-item="item"
            wx:for-index="iIndex"
            class="lib-item"
            hover-class="lib-item-hover"
            bind:tap="pickExam"
            data-id="{{item.id}}"
          >
            <view class="lib-index en">{{iIndex + 1}}</view>
            <view class="lib-item-copy">
              <view class="lib-item-head">
                <text class="lib-item-title lib-item-title-clamp">{{item.title}}</text>
                <text wx:if="{{item.progressLabel}}" class="lib-progress {{item.progressDone ? 'lib-progress-done' : ''}}">{{item.progressLabel}}</text>
              </view>
              <view class="lib-item-meta">
                <text class="lib-issue">{{item.issue}}</text>
                <text wx:if="{{item.topic}}" class="lib-dot">·</text>
                <text wx:if="{{item.topic}}" class="lib-topic">{{item.topic}}</text>
                <text wx:if="{{item.words}}" class="lib-dot">·</text>
                <text wx:if="{{item.words}}" class="lib-words en">{{item.words}} words</text>
              </view>
            </view>
            <view class="lib-arrow"></view>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{examLoading}}" class="lib-empty">
      <cat-image name="sleepy-nap" size="medium" />
      <text>猫正在翻真题档案…</text>
    </view>
    <view wx:else class="lib-empty">
      <cat-image name="not-found" size="medium" />
      <text>这个级别暂时没有内置真题。</text>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{mineView.length}}" class="lib-list">
      <view
        wx:for="{{mineView}}"
        wx:key="_id"
        class="lib-item enter"
        hover-class="lib-item-hover"
        bind:tap="pickMine"
        bind:longpress="removeMine"
        data-id="{{item._id}}"
      >
        <view class="lib-index en">{{index + 1}}</view>
        <view class="lib-item-copy">
          <view class="lib-item-head">
            <text class="lib-item-title">{{item.title}}</text>
            <text wx:if="{{item.progressLabel}}" class="lib-progress {{item.progressDone ? 'lib-progress-done' : ''}}">{{item.progressLabel}}</text>
          </view>
          <view wx:if="{{item.issue || item.topic || item.words}}" class="lib-item-meta">
            <text wx:if="{{item.issue}}" class="lib-issue">{{item.issue}}</text>
            <text wx:if="{{item.issue && item.topic}}" class="lib-dot">·</text>
            <text wx:if="{{item.topic}}" class="lib-topic">{{item.topic}}</text>
            <text wx:if="{{item.topic && item.words}}" class="lib-dot">·</text>
            <text wx:if="{{item.words}}" class="lib-words en">{{item.words}} words</text>
          </view>
        </view>
        <view class="lib-arrow"></view>
      </view>
    </view>
    <view wx:elif="{{mineLoading}}" class="lib-empty">
      <cat-image name="sleepy-nap" size="medium" />
      <text>猫正在翻你的书架…</text>
    </view>
    <view wx:else class="lib-empty">
      <cat-image name="not-found" size="medium" />
      <text>这个级别还没有导入的文章。上传文档或粘贴原文，就会出现在这里。</text>
      <view class="lib-empty-btn" bind:tap="goImport">去导入一篇</view>
    </view>

    <!-- 已有篇目时也要能继续往当前分类里加 -->
    <view wx:if="{{mineView.length}}" class="lib-import-tip" hover-class="lib-import-hover" hover-stay-time="80" bind:tap="goImport">
      <view class="lib-import-copy">
        <text class="lib-import-title">再收一篇到我的导入</text>
        <text class="lib-import-desc">上传 Word / PDF 或粘贴原文，随时打开精读</text>
      </view>
      <view class="lib-import-cta">
        <text>去导入</text>
        <view class="lib-arrow"></view>
      </view>
    </view>
  </block>

  <view class="lib-note">
    <text wx:if="{{source === 'exams'}}">版权说明：真题原文著作权归考试主办方所有，已随小程序内置，仅供个人学习；点开即学，不需要你再上传。</text>
    <text wx:elif="{{source === 'bank'}}">版权说明：内置模拟篇为原创分级文章，不含真题原文。</text>
    <text wx:else>长按列表里的任意一篇可以补上考试年份或删除；删除只清正文、进度和练习记录，已收藏的生词和语法不受影响。</text>
  </view>

  <view wx:if="{{starting}}" class="lib-mask">
    <view class="lib-mask-card">
      <cat-image name="sleepy-nap" size="medium" />
      <text class="lib-mask-title">猫正在翻这篇文章</text>
      <text class="lib-mask-text">{{startingTitle}}</text>
    </view>
  </view>
</view>
