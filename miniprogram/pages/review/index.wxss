.review-page {
  padding-bottom: 60rpx;
}

/* ---------- 顶部进度 ---------- */
.review-progress {
  position: relative;
  margin-bottom: 26rpx;
  padding: 24rpx 26rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: rgba(255, 253, 246, 0.92);
  box-shadow: var(--shadow-paper);
}

.review-progress-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.review-progress-label {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--ink);
}

.review-progress-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #a86a11;
}

.review-progress-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* ---------- 复习卡片 ---------- */
.review-card {
  position: relative;
  padding: 44rpx 28rpx 28rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: linear-gradient(155deg, #fffef9 0%, #fffaf0 100%);
  box-shadow: var(--shadow-paper);
}

.review-tape {
  position: absolute;
  top: -12rpx;
  left: 40rpx;
  width: 96rpx;
  height: 26rpx;
  pointer-events: none;
  background: rgba(255, 226, 160, 0.82);
  transform: rotate(-4deg);
}

.review-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.review-kicker {
  display: block;
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--faint);
}

.review-stage {
  flex: none;
  padding: 6rpx 16rpx;
  border: 2rpx solid rgba(168, 106, 17, 0.24);
  border-radius: 999rpx;
  background: #fff3cf;
  color: #8a5a0d;
  font-size: 19rpx;
  font-weight: 700;
}

/* ---------- 复习曲线：1 / 3 / 7 / 15 / 30 / 半年 ---------- */
.review-curve {
  position: relative;
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
  padding: 22rpx 16rpx 16rpx;
  border: 2rpx dashed rgba(168, 106, 17, 0.26);
  border-radius: 22rpx;
  background: rgba(255, 246, 219, 0.5);
}

.review-curve::before {
  content: '';
  position: absolute;
  left: 64rpx;
  right: 64rpx;
  top: 33rpx;
  height: 2rpx;
  background: rgba(168, 106, 17, 0.18);
}

.curve-item {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.curve-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 3rpx 0;
  border: 2rpx solid rgba(168, 106, 17, 0.36);
  border-radius: 50%;
  background: #fffdf6;
}

.curve-done .curve-dot {
  border-color: #c98a2e;
  background: #f0c37a;
}

.curve-now .curve-dot {
  width: 22rpx;
  height: 22rpx;
  margin: 0;
  border: 4rpx solid #c9832a;
  background: #ffdf9a;
  box-shadow: 0 0 0 6rpx rgba(255, 223, 154, 0.35);
}

.curve-label {
  font-size: 19rpx;
  color: var(--faint);
  white-space: nowrap;
}

.curve-done .curve-label {
  color: #a8763c;
}

.curve-now .curve-label {
  color: #8a5a0d;
  font-weight: 700;
}

.review-curve-hint {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  color: var(--muted);
  font-size: 20rpx;
}

.review-word-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
  min-width: 0;
}

.review-word {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  word-break: break-all;
}

.review-phonetic {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.review-nomap {
  display: block;
  margin-top: 18rpx;
  font-size: 25rpx;
  color: var(--muted);
}

.review-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.review-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 108rpx;
  padding: 14rpx 12rpx;
  border: 2rpx solid rgba(75, 64, 52, 0.28);
  border-radius: var(--r-sm);
  box-shadow: 4rpx 5rpx 0 rgba(103, 73, 40, 0.12);
}

.review-btn-busy {
  opacity: 0.6;
}

.review-unknown {
  background: #fbe6cf;
}

.review-known {
  background: #d9ecd9;
}

.review-btn-main {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.review-btn-hint {
  font-size: 20rpx;
  color: var(--muted);
}

/* ---------- 完成态 ---------- */
.review-done {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 40rpx 28rpx 34rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: rgba(255, 253, 246, 0.94);
  box-shadow: var(--shadow-paper);
  text-align: center;
}

.done-cat {
  width: 180rpx;
  height: 180rpx;
}

.done-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.done-text {
  margin-bottom: 18rpx;
  font-size: 25rpx;
  color: var(--muted);
}
