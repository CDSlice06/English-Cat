.review-page {
  display: flex;
  flex-direction: column;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 内容没占满时，卡片在页头与底部操作栏之间居中，避免下半屏空出一大块 */
.review-card,
.review-done {
  margin-top: auto;
  margin-bottom: auto;
}

/* ---------- 顶部进度 ---------- */
.review-progress {
  position: relative;
  margin-bottom: 22rpx;
  padding: 18rpx 24rpx 20rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: rgba(255, 253, 246, 0.92);
  box-shadow: var(--shadow-paper);
}

.review-progress-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.review-progress-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.review-progress-value {
  margin-left: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #a86a11;
}

.review-progress-bar {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(168, 106, 17, 0.14);
  overflow: hidden;
}

.review-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f0c37a, #c9832a);
}

.review-cap-hint {
  display: block;
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}

/* ---------- 每日复习量：词汇与语法各记各的 ---------- */
.review-target {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: -8rpx 0 22rpx;
  padding: 0 8rpx;
}

.review-target-label {
  flex: none;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
}

.review-target-options {
  flex: 1;
  display: flex;
  gap: 10rpx;
}

.review-target-chip {
  flex: 1;
  padding: 8rpx 0;
  border: 2rpx dashed rgba(168, 106, 17, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 251, 240, 0.9);
  color: var(--muted);
  font-size: 22rpx;
  text-align: center;
  transition: background 0.15s ease, color 0.15s ease;
}

.review-target-chip-on {
  border-style: solid;
  border-color: rgba(168, 106, 17, 0.5);
  background: #ffdf9a;
  color: #6b4a0e;
  font-weight: 700;
}

.review-target-unit {
  flex: none;
  color: var(--faint);
  font-size: 21rpx;
}

.review-target-help {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid rgba(168, 106, 17, 0.32);
  border-radius: 50%;
  color: #a8763c;
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
}

.review-target-help-hover {
  background: rgba(255, 226, 160, 0.5);
}

/* ---------- 复习卡片 ---------- */
.review-card {
  position: relative;
  padding: 44rpx 28rpx 28rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: linear-gradient(155deg, #fffef9 0%, #fffaf0 100%);
  box-shadow: var(--shadow-paper);
}

.review-tape {
  position: absolute;
  top: -12rpx;
  left: 40rpx;
  width: 96rpx;
  height: 26rpx;
  pointer-events: none;
  background: rgba(255, 226, 160, 0.82);
  transform: rotate(-4deg);
}

.review-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.review-kicker {
  display: block;
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--faint);
}

.review-early {
  flex: none;
  padding: 4rpx 14rpx;
  border: 2rpx dashed rgba(168, 106, 17, 0.36);
  border-radius: 999rpx;
  color: #a8763c;
  font-size: 18rpx;
  font-weight: 700;
}

.review-stage {
  flex: none;
  padding: 6rpx 16rpx;
  border: 2rpx solid rgba(168, 106, 17, 0.24);
  border-radius: 999rpx;
  background: #fff3cf;
  color: #8a5a0d;
  font-size: 19rpx;
  font-weight: 700;
}

/* ---------- 复习节奏：默认只显示第几档，曲线按需展开 ---------- */
.review-meaning-scroll {
  max-height: 40vh;
  margin-top: 16rpx;
}

.review-stage-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
}

.review-stage-dots {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stage-dot {
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid rgba(168, 106, 17, 0.32);
  border-radius: 50%;
  background: #fffdf6;
}

.stage-dot-done {
  border-color: #c98a2e;
  background: #f0c37a;
}

.stage-dot-now {
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #c9832a;
  background: #ffdf9a;
  box-shadow: 0 0 0 5rpx rgba(255, 223, 154, 0.3);
}

.review-stage-text {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: #8a5a0d;
}

.review-curve-toggle {
  display: block;
  padding: 10rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  text-decoration: underline;
}

.review-curve {
  position: relative;
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
  padding: 22rpx 16rpx 16rpx;
  border: 2rpx dashed rgba(168, 106, 17, 0.26);
  border-radius: 22rpx;
  background: rgba(255, 246, 219, 0.5);
}

.review-curve::before {
  content: '';
  position: absolute;
  left: 64rpx;
  right: 64rpx;
  top: 33rpx;
  height: 2rpx;
  background: rgba(168, 106, 17, 0.18);
}

.curve-item {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.curve-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 3rpx 0;
  border: 2rpx solid rgba(168, 106, 17, 0.36);
  border-radius: 50%;
  background: #fffdf6;
}

.curve-done .curve-dot {
  border-color: #c98a2e;
  background: #f0c37a;
}

.curve-now .curve-dot {
  width: 22rpx;
  height: 22rpx;
  margin: 0;
  border: 4rpx solid #c9832a;
  background: #ffdf9a;
  box-shadow: 0 0 0 6rpx rgba(255, 223, 154, 0.35);
}

.curve-label {
  font-size: 22rpx;
  color: var(--faint);
  white-space: nowrap;
}

.curve-done .curve-label {
  color: #a8763c;
}

.curve-now .curve-label {
  color: #8a5a0d;
  font-weight: 700;
}

.review-curve-hint {
  flex: none;
  margin-left: auto;
  color: var(--muted);
  font-size: 24rpx;
  white-space: nowrap;
}

.review-word-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
  min-width: 0;
}

.review-word {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  word-break: break-all;
}

.review-phonetic {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.review-nomap {
  display: block;
  margin-top: 18rpx;
  font-size: 25rpx;
  color: var(--muted);
}

.review-reveal {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 36rpx 24rpx;
  border: 2rpx dashed rgba(75, 64, 52, 0.3);
  border-radius: var(--r-sm);
  background: rgba(255, 253, 246, 0.7);
}

.review-reveal-hint {
  font-size: 24rpx;
  color: var(--muted);
}

.review-reveal-btn {
  padding: 16rpx 48rpx;
  border: 2rpx solid rgba(75, 64, 52, 0.28);
  border-radius: 999rpx;
  background: #f3e8d3;
  box-shadow: 4rpx 5rpx 0 rgba(103, 73, 40, 0.12);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

/* ---------- 底部固定操作栏 ---------- */
.review-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--paper-line);
  background: rgba(255, 253, 246, 0.97);
  box-shadow: 0 -8rpx 24rpx rgba(75, 64, 52, 0.06);
}

.review-footer-hint {
  display: block;
  margin-bottom: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

.review-sibling {
  margin-top: 16rpx;
  color: var(--faint);
  font-size: 22rpx;
  text-align: center;
}

.review-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 0;
}

.review-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 96rpx;
  padding: 12rpx;
  border: 2rpx solid rgba(75, 64, 52, 0.28);
  border-radius: var(--r-sm);
  box-shadow: 4rpx 5rpx 0 rgba(103, 73, 40, 0.12);
}

.review-btn-busy {
  opacity: 0.6;
}

.review-unknown {
  background: #fbe6cf;
}

.review-fuzzy {
  background: #fdf3d7;
}

.review-known {
  background: #d9ecd9;
}

.review-btn-muted {
  opacity: 0.5;
  box-shadow: none;
}

.review-btn-main {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.review-btn-hint {
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  color: var(--muted);
}

/* ---------- 完成态 ---------- */
.review-done {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 28rpx 34rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: rgba(255, 253, 246, 0.94);
  box-shadow: var(--shadow-paper);
  text-align: center;
}

.done-cat {
  width: 180rpx;
  height: 180rpx;
}

.done-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.done-text {
  margin-bottom: 18rpx;
  font-size: 26rpx;
  color: var(--muted);
}

/* ---------- 词汇 / 语法切换 ---------- */
.review-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 22rpx;
  padding: 8rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.86);
  box-shadow: var(--shadow-paper);
}

.review-tab {
  flex: 1;
  padding: 12rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
}

.review-tab-active {
  background: #fff3cf;
  box-shadow: inset 0 0 0 2rpx rgba(168, 106, 17, 0.16);
  font-weight: 700;
  color: #8a5a0d;
}

/* ---------- 语法卡 ---------- */
.review-source {
  max-width: 62%;
  overflow: hidden;
  font-size: 21rpx;
  color: var(--faint);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-grammar-key {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
}

.review-grammar-sentence {
  display: block;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid rgba(168, 106, 17, 0.32);
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
  background: rgba(255, 247, 229, 0.72);
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink);
}

.review-grammar-pattern {
  display: block;
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.6;
  color: #8a5a0d;
}

.review-grammar-translation {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--muted);
}

.review-grammar-text {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--ink);
}

.review-grammar-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.review-grammar-examples {
  margin-top: 14rpx;
}

.review-grammar-example {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border: 2rpx dashed rgba(75, 64, 52, 0.22);
  border-radius: var(--r-sm);
  background: rgba(255, 253, 246, 0.7);
}

.review-grammar-ex-en {
  display: block;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--ink);
}

.review-grammar-ex-zh {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--muted);
}

/* ---------- 词组补充 ---------- */
.review-phrase-extra {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.review-phrase-sentence {
  display: block;
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--r-sm);
  background: rgba(255, 247, 229, 0.72);
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink);
}

/* 显示答案后补的例句和中文，帮助把词放回语境里回忆 */
.review-example {
  display: block;
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-left: 4rpx solid rgba(168, 106, 17, 0.35);
  border-radius: var(--r-sm);
  background: rgba(255, 247, 229, 0.72);
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink);
}

.review-example-zh {
  display: block;
  margin-top: 6rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--faint);
}

/* 自己画的记忆草图 */
.review-drawing {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-top: 14rpx;
  padding: 10rpx;
  border: 2rpx dashed rgba(168, 106, 17, 0.35);
  border-radius: var(--r-md);
  background: rgba(255, 253, 249, 0.92);
}

.review-drawing-img {
  width: 100%;
  height: 200rpx;
}

.review-drawing-tip {
  color: var(--faint);
  font-size: 20rpx;
}

.review-drawing-del {
  color: #b23b30;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
}

.review-draw-btn {
  margin-top: 12rpx;
  padding: 14rpx 0;
  border: 2rpx dashed rgba(168, 106, 17, 0.45);
  border-radius: var(--r-md);
  background: rgba(255, 243, 212, 0.55);
  color: var(--amber);
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
}
