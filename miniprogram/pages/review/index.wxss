.review-page {
  padding-bottom: 60rpx;
}

/* ---------- 顶部进度 ---------- */
.review-progress {
  position: relative;
  margin-bottom: 26rpx;
  padding: 24rpx 26rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: rgba(255, 253, 246, 0.92);
  box-shadow: var(--shadow-paper);
}

.review-progress-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.review-progress-label {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--ink);
}

.review-progress-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #a86a11;
}

.review-progress-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* ---------- 复习卡片 ---------- */
.review-card {
  position: relative;
  padding: 44rpx 28rpx 28rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: linear-gradient(155deg, #fffef9 0%, #fffaf0 100%);
  box-shadow: var(--shadow-paper);
}

.review-tape {
  position: absolute;
  top: -12rpx;
  left: 40rpx;
  width: 96rpx;
  height: 26rpx;
  pointer-events: none;
  background: rgba(255, 226, 160, 0.82);
  transform: rotate(-4deg);
}

.review-kicker {
  display: block;
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--faint);
}

.review-word-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
  min-width: 0;
}

.review-word {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  word-break: break-all;
}

.review-phonetic {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.review-nomap {
  display: block;
  margin-top: 18rpx;
  font-size: 25rpx;
  color: var(--muted);
}

.review-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.review-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 108rpx;
  padding: 14rpx 12rpx;
  border: 2rpx solid rgba(75, 64, 52, 0.28);
  border-radius: var(--r-sm);
  box-shadow: 4rpx 5rpx 0 rgba(103, 73, 40, 0.12);
}

.review-btn-busy {
  opacity: 0.6;
}

.review-unknown {
  background: #fbe6cf;
}

.review-known {
  background: #d9ecd9;
}

.review-btn-main {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.review-btn-hint {
  font-size: 20rpx;
  color: var(--muted);
}

/* ---------- 完成态 ---------- */
.review-done {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 40rpx 28rpx 34rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: rgba(255, 253, 246, 0.94);
  box-shadow: var(--shadow-paper);
  text-align: center;
}

.done-cat {
  width: 180rpx;
  height: 180rpx;
}

.done-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.done-text {
  margin-bottom: 18rpx;
  font-size: 25rpx;
  color: var(--muted);
}
