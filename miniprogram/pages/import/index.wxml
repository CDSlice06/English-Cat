<view class="page import">
  <view wx:if="{{loading}}" class="loading">
    <cat-image custom-class="state-cat" name="sleepy-nap" size="large" />
    <text>正在加载学习数据…</text>
  </view>
  <view wx:elif="{{error}}" class="error-box">
    <cat-image custom-class="state-cat" name="not-found" size="large" />
    <text class="error-text">{{error}}</text>
    <primary-button text="重新加载" bind:tap="loadPage" />
  </view>
  <block wx:else>
    <section-title eyebrow="STEP 01 · IMPORT" title="导入精读文章" description="复制一段英文原文粘进来，自动拆句、标生词、排语法。" />

    <!-- 粘贴入口 -->
    <view class="file-card enter d2">
      <view class="file-tape"></view>
      <view class="file-head" hover-class="file-head-hover" bind:tap="goManual">
        <view class="file-badge file-badge-empty">
          <view class="file-plus"></view>
        </view>
        <view class="file-copy">
          <text class="file-name">粘贴英文原文</text>
          <text class="file-meta">外刊、课本、笔记段落都可以，粘进来就能开始精读</text>
        </view>
        <view class="file-enter"></view>
      </view>
      <view class="file-hint">
        <text class="file-hint-text">不用整篇都贴，一段也可以。中文和乱码会自动过滤，只保留英文正文。</text>
        <text class="file-hint-note">真题已经内置在题库里，不需要自己上传文件。</text>
      </view>
    </view>

    <view class="actions enter d3">
      <primary-button text="从题库抽一篇" secondary="{{true}}" bind:tap="goBank" />
      <view class="manual-link" bind:tap="goJournals">
        <text>没带文章？去读今天的英语外刊</text>
        <view class="manual-arrow"></view>
      </view>
    </view>
  </block>
</view>
