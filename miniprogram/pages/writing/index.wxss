page {
  background: #fdf7ea;
}

.writing-page {
  padding: 24rpx 28rpx 60rpx;
  color: #2f2a22;
}

.en {
  font-family: Georgia, 'Times New Roman', serif;
  letter-spacing: 1rpx;
}

.hero {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fffdf9;
  border: 2rpx solid #efe2c9;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(168, 106, 17, 0.08);
}

.hero-photo {
  width: 150rpx;
  flex: 0 0 150rpx;
}

.hero-cat {
  width: 150rpx;
  height: 150rpx;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.hero-kicker {
  font-size: 20rpx;
  color: #b09a78;
}

.hero-title {
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #6b4a14;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8b7a63;
}

.progress-card {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  background: #fff8e9;
  border: 2rpx solid #f0e0c2;
  border-radius: 24rpx;
}

.progress-copy {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.progress-label {
  font-size: 24rpx;
  color: #8b7a63;
}

.progress-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #a86a11;
}

.progress-total {
  font-size: 24rpx;
  font-weight: 400;
  color: #b09a78;
}

.progress-track {
  height: 10rpx;
  margin-top: 14rpx;
  background: #f1e4cb;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #e2a23c;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

.filter-row {
  display: flex;
  margin: 24rpx 0 18rpx;
}

.filter-chip {
  padding: 10rpx 30rpx;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: #8b7a63;
  background: #fffdf9;
  border: 2rpx solid #efe2c9;
  border-radius: 999rpx;
}

.filter-chip.active {
  color: #fff;
  background: #a86a11;
  border-color: #a86a11;
}

.question-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #fffdf9;
  border: 2rpx solid #efe2c9;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(168, 106, 17, 0.06);
}

.question-card-hover {
  background: #fff8ec;
}

.question-card.passed {
  border-color: #d9e8cd;
}

.question-head {
  display: flex;
  align-items: center;
}

.level-tag {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: #fff;
  background: #a86a11;
  border-radius: 8rpx;
}

.level-tag.cet6 {
  background: #5d7ea8;
}

.question-year {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #b09a78;
}

.question-status {
  margin-left: auto;
  font-size: 22rpx;
  color: #b09a78;
}

.question-card.passed .question-status {
  color: #6f8f52;
}

.question-topic {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #3a3226;
}

.question-prompt {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  font-size: 25rpx;
  line-height: 1.6;
  color: #7c6d58;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.question-foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.question-meta {
  margin-right: 24rpx;
  font-size: 22rpx;
  color: #b09a78;
}

.question-foot .unit-arrow {
  margin-left: auto;
}

.unit-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #c9b48f;
  border-right: 3rpx solid #c9b48f;
  transform: rotate(45deg);
}

.state-card {
  padding: 50rpx 30rpx;
  background: #fffdf9;
  border: 2rpx dashed #e8d9bd;
  border-radius: 24rpx;
  text-align: center;
}

.state-text {
  font-size: 26rpx;
  color: #b09a78;
}

.tips-card {
  margin-top: 28rpx;
  padding: 24rpx;
  background: #fbf3e2;
  border-radius: 24rpx;
}

.tips-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #8a6a2f;
}

.tips-line {
  display: block;
  font-size: 23rpx;
  line-height: 1.75;
  color: #96826a;
}
