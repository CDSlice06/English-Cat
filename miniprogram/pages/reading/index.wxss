/* ---------- 页面骨架 ---------- */
.reading-page {
  min-height: 100vh;
  padding: 0 24rpx 60rpx;
  box-sizing: border-box;
}

.state {
  padding: 140rpx 40rpx;
  text-align: center;
}

.state-title {
  display: block;
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.7;
}

.state-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--faint);
  font-size: 22rpx;
}

.state-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  background: var(--amber);
  color: #fffdf9;
  font-size: 24rpx;
  font-weight: 600;
}

/* ---------- 吸顶计时与开关 ---------- */
.read-head {
  position: sticky;
  top: 0;
  z-index: 20;
  margin: 0 -24rpx;
  padding: 12rpx 24rpx 10rpx;
  background: rgba(253, 247, 234, 0.97);
  border-bottom: 2rpx dashed var(--line);
}

.read-article-head {
  padding: 18rpx 2rpx 6rpx;
  border-bottom: none;
}

.timer-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.timer-copy {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.timer-kicker {
  color: var(--faint);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.timer-value {
  flex: none;
  color: var(--ink);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.timer-total {
  color: var(--faint);
  font-family: var(--font-body);
  font-size: 19rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.timer-state {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 600;
}

.timer-state.is-live {
  background: rgba(93, 138, 106, 0.12);
  color: #4f7a5b;
}

.timer-state.is-paused {
  background: rgba(168, 106, 17, 0.12);
  color: #8a6a2d;
}

.timer-state.is-done {
  background: rgba(168, 106, 17, 0.16);
  color: #8a6a2d;
}

.bar {
  height: 8rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: rgba(48, 40, 28, 0.09);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d8a854, #a86a11);
  transition: width 0.35s ease;
}

.bar-fill.bar-done {
  background: linear-gradient(90deg, #7fae8c, #5d8a6a);
}

.timer-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--faint);
  font-size: 19rpx;
  line-height: 1.5;
}

.tools {
  display: flex;
  flex: 1;
  gap: 8rpx;
  min-width: 0;
}

.tool {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx 0;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--paper);
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 600;
}

.tool.is-on {
  color: var(--ink);
}

.tool-mode.is-on {
  font-weight: 700;
}

.mode-plain.is-on {
  border-color: rgba(48, 40, 28, 0.45);
  background: rgba(48, 40, 28, 0.07);
}

.mode-study.is-on {
  border-color: rgba(93, 138, 106, 0.6);
  background: rgba(93, 138, 106, 0.13);
}

.mode-review.is-on {
  border-color: rgba(168, 106, 17, 0.55);
  background: rgba(255, 226, 160, 0.36);
}

.tool-display {
  flex: 0 0 58rpx;
  padding: 7rpx 0 9rpx;
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 25rpx;
  letter-spacing: 0;
}

.mode-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--faint);
  font-size: 19rpx;
  line-height: 1.5;
}

/* ---------- 正文卡片 ---------- */
.article-card {
  margin-top: 20rpx;
  padding: 26rpx 26rpx 20rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-lg);
  background: var(--paper);
  box-shadow: 7rpx 8rpx 0 rgba(168, 106, 17, 0.07);
}

.article-head {
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed var(--line);
}

.article-title {
  display: block;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
}

/* ---------- 读前导读 ---------- */
.guide-card {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--paper-line);
  border-left: 6rpx solid var(--amber);
  border-radius: var(--r-lg);
  background: #fff8e9;
}

.guide-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.guide-head-copy {
  flex: 1;
  min-width: 0;
}

.guide-kicker {
  display: block;
  color: var(--amber);
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
}

.guide-title {
  display: block;
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.5;
}

.guide-toggle {
  flex: 0 0 auto;
  padding-top: 4rpx;
  color: var(--amber);
  font-size: 21rpx;
}

.guide-body {
  margin-top: 14rpx;
}

.guide-summary {
  display: block;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.75;
}

.guide-block {
  margin-top: 16rpx;
}

.guide-label {
  display: block;
  color: var(--faint);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.guide-question {
  display: block;
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 23rpx;
  line-height: 1.7;
}

.article-meta {
  display: block;
  margin-top: 6rpx;
  color: var(--faint);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.paragraph {
  margin-top: 20rpx;
}

.para-en {
  color: var(--ink);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 33rpx;
  line-height: 1.95;
  word-break: break-word;
}

.tok {
  border-radius: 3rpx;
}

/* 词组用浅蓝底；长难句只用一条细下划线，两个开关一起开也不会互相盖住 */
.tok-phrase {
  border-radius: 3rpx;
  background: rgba(111, 145, 173, 0.18);
}

.tok-grammar {
  box-shadow: inset 0 -2rpx 0 rgba(93, 138, 106, 0.32);
}

/* 句尾句型标签：写清是定语从句还是倒装，比一个「语」字更有用 */
.grammar-label {
  display: inline-block;
  margin: 0 3rpx;
  padding: 0 8rpx;
  border: 1rpx solid rgba(93, 138, 106, 0.24);
  border-radius: 6rpx;
  background: rgba(93, 138, 106, 0.12);
  color: #4f7a5b;
  font-family: -apple-system, 'PingFang SC', sans-serif;
  font-size: 17rpx;
  line-height: 28rpx;
  vertical-align: 4rpx;
  animation: grammar-label-in 0.22s ease both;
}

@keyframes grammar-label-in {
  from {
    opacity: 0;
    transform: translateY(3rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---------- 阅读显示：字号 / 行距 / 夜间 ---------- */
.reading-page.fs-sm .para-en {
  font-size: 30rpx;
}

.reading-page.fs-md .para-en {
  font-size: 33rpx;
}

.reading-page.fs-lg .para-en {
  font-size: 38rpx;
}

.reading-page.lh-normal .para-en {
  line-height: 1.95;
}

.reading-page.lh-loose .para-en {
  line-height: 2.2;
}

.reading-page.is-night {
  --ink: #ece7dc;
  --ink-2: #d6cec1;
  --muted: #aaa295;
  --faint: #8f877a;
  --paper: #24282b;
  --paper-line: rgba(255, 248, 236, 0.18);
  --line: rgba(255, 248, 236, 0.14);
  --line-2: rgba(255, 248, 236, 0.08);
  background: #191c1e;
}

.reading-page.is-night .read-head {
  background: rgba(25, 28, 30, 0.97);
}

.reading-page.is-night .tool {
  background: #24282b;
}

.reading-page.is-night .tool.mode-plain.is-on {
  border-color: rgba(255, 248, 236, 0.35);
  background: rgba(255, 248, 236, 0.08);
}

.reading-page.is-night .tool.mode-study.is-on {
  background: rgba(127, 174, 140, 0.18);
}

.reading-page.is-night .tool.mode-review.is-on {
  background: rgba(216, 168, 84, 0.18);
}

.reading-page.is-night .para-zh {
  background: rgba(255, 226, 160, 0.08);
  border-left-color: rgba(216, 168, 84, 0.55);
}

.reading-page.is-night .tok-phrase {
  background: rgba(111, 145, 173, 0.32);
}

.reading-page.is-night .grammar-label {
  border-color: rgba(127, 174, 140, 0.36);
  background: rgba(127, 174, 140, 0.18);
  color: #a9d0b6;
}

.reading-page.is-night .article-card {
  box-shadow: 7rpx 8rpx 0 rgba(0, 0, 0, 0.28);
}

.reading-page.is-night .timer-state.is-live {
  background: rgba(127, 174, 140, 0.16);
  color: #a9d0b6;
}

.reading-page.is-night .timer-state.is-paused,
.reading-page.is-night .timer-state.is-done {
  background: rgba(216, 168, 84, 0.18);
  color: #e2be7f;
}

.reading-page.is-night .panel-mask {
  background: rgba(0, 0, 0, 0.6);
}

.reading-page.is-night .pos {
  color: #d8b06a;
}

.reading-page.is-night .mini-add {
  border-color: rgba(111, 145, 173, 0.6);
  color: #9fc3e0;
}

.para-zh {
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-left: 4rpx solid rgba(168, 106, 17, 0.35);
  border-radius: 0 10rpx 10rpx 0;
  background: rgba(255, 226, 160, 0.2);
}

.zh-text {
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 1.8;
}

.zh-hint {
  color: var(--faint);
  font-size: 22rpx;
}

.trans-error {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(190, 92, 78, 0.1);
  color: #a4503f;
  font-size: 22rpx;
  text-align: center;
}

.read-tips {
  margin-top: 22rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--faint);
  font-size: 19rpx;
  line-height: 1.7;
}

/* 读完后接下一篇 */
.next-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid rgba(168, 106, 17, 0.24);
  border-radius: var(--r-lg);
  background: rgba(255, 226, 160, 0.18);
}

.next-copy {
  flex: 1;
  min-width: 0;
}

.next-kicker {
  display: block;
  color: var(--amber);
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
}

.next-title {
  display: block;
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.next-meta {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.next-btn {
  flex: 0 0 auto;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: var(--amber);
  color: #fffdf9;
  font-size: 23rpx;
  font-weight: 700;
}

.next-btn.is-busy {
  opacity: 0.7;
}

/* ---------- 底部释义面板 ---------- */
.panel-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(36, 31, 24, 0.4);
}

.panel {
  width: 100%;
  max-height: 72vh;
  padding: 28rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--paper);
  box-sizing: border-box;
  overflow-y: auto;
  animation: panel-rise 0.24s ease both;
}

@keyframes panel-rise {
  from { transform: translateY(40rpx); opacity: 0.5; }
  to { transform: translateY(0); opacity: 1; }
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed var(--line);
}

.panel-head-copy {
  flex: 1;
  padding-right: 20rpx;
}

.panel-head-tools {
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.panel-kicker {
  display: block;
  color: var(--amber);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
}

.panel-title {
  display: block;
  margin-top: 6rpx;
  color: var(--ink);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.panel-phonetic {
  display: block;
  margin-top: 4rpx;
  color: var(--faint);
  font-size: 22rpx;
}

.panel-close {
  padding: 0 8rpx;
  color: var(--faint);
  font-size: 44rpx;
  line-height: 1;
}

.panel-hint {
  display: block;
  padding: 24rpx 0;
  color: var(--faint);
  font-size: 24rpx;
  line-height: 1.7;
}

.meanings {
  padding-top: 12rpx;
}

.meaning-row {
  display: flex;
  gap: 12rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.pos {
  flex: 0 0 auto;
  color: #8a6a2d;
  font-size: 21rpx;
  font-style: italic;
}

.meaning-text {
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.65;
}

/* 近义：词卡上一排可以点开的词 */
.panel-syn {
  margin-top: 16rpx;
}

.panel-syn-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.panel-syn-chip {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: #567a96;
  font-size: 22rpx;
  background: rgba(111, 145, 173, 0.12);
}

.panel-syn-chip:active {
  opacity: 0.7;
}

.panel-caption {
  display: block;
  padding-top: 14rpx;
  color: var(--faint);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.panel-body {
  display: block;
  padding-top: 16rpx;
  color: var(--ink-2);
  font-size: 27rpx;
  line-height: 1.8;
}

.panel-note {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.75;
}

.panel-quote {
  display: block;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-left: 4rpx solid rgba(111, 145, 173, 0.5);
  border-radius: 0 10rpx 10rpx 0;
  background: rgba(111, 145, 173, 0.09);
  color: var(--ink-2);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 25rpx;
  line-height: 1.7;
}

/* 长难句分块：一块英文配一块中文，先看懂结构再看步骤 */
.chunks {
  margin-top: 14rpx;
}

.chunk-row {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed var(--line-2);
}

.chunk-index {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(93, 138, 106, 0.14);
  color: #4f7a5b;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.chunk-copy {
  flex: 1;
}

.chunk-en {
  display: block;
  color: var(--ink);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 25rpx;
  line-height: 1.6;
}

.chunk-zh {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.steps {
  margin-top: 14rpx;
}

.step {
  padding: 8rpx 0;
}

.step-title {
  display: block;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 600;
}

.step-detail {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.7;
}

.phrase-note {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(111, 145, 173, 0.1);
}

.sub-label {
  display: block;
  color: var(--faint);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.sub-title {
  display: block;
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.sub-text {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.mini-add {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 22rpx;
  border: 2rpx solid rgba(111, 145, 173, 0.5);
  border-radius: 999rpx;
  color: #567a96;
  font-size: 21rpx;
  font-weight: 600;
}

.mini-add.is-added {
  border-color: var(--line);
  color: var(--faint);
}

/* ---------- 显示设置 ---------- */
.display-group {
  padding-top: 20rpx;
}

.display-label {
  display: block;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
}

.display-options {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.display-option {
  flex: 1;
  padding: 12rpx 0;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--muted);
  font-size: 23rpx;
  text-align: center;
}

.display-option.is-on {
  border-color: rgba(168, 106, 17, 0.55);
  background: rgba(255, 226, 160, 0.28);
  color: var(--ink);
  font-weight: 700;
}

.display-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--line);
}

.display-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--faint);
  font-size: 20rpx;
}

.switch {
  width: 82rpx;
  height: 46rpx;
  padding: 5rpx;
  border-radius: 999rpx;
  background: rgba(48, 40, 28, 0.14);
  box-sizing: border-box;
}

.switch.is-on {
  background: #5d8a6a;
}

.switch-knob {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fffdf9;
  transition: transform 0.2s ease;
}

.switch.is-on .switch-knob {
  transform: translateX(36rpx);
}

.panel-actions {
  margin-top: 24rpx;
}

.panel-btn {
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: var(--amber);
  color: #fffdf9;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 1rpx;
}

.panel-btn.is-added {
  background: rgba(93, 138, 106, 0.16);
  color: #4f7a5b;
}

.panel-btn.is-busy {
  opacity: 0.6;
}

/* ---------- 读完小结 ---------- */
.done-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  background: rgba(36, 31, 24, 0.48);
}

.done-card {
  width: 100%;
  padding: 34rpx 30rpx 26rpx;
  border-radius: 28rpx;
  background: var(--paper);
  box-shadow: 10rpx 12rpx 0 rgba(168, 106, 17, 0.14);
  text-align: center;
  animation: done-pop 0.26s ease both;
}

.done-kicker {
  display: block;
  color: var(--amber);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.done-title {
  display: block;
  margin-top: 10rpx;
  color: var(--ink);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 42rpx;
  font-weight: 700;
}

.done-sub {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.done-stats {
  display: flex;
  margin-top: 24rpx;
  padding: 18rpx 0;
  border-top: 2rpx dashed var(--line);
  border-bottom: 2rpx dashed var(--line);
}

.done-stat {
  flex: 1;
}

.done-num {
  display: block;
  color: var(--ink);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 40rpx;
  font-weight: 700;
}

.done-label {
  display: block;
  margin-top: 4rpx;
  color: var(--faint);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.done-btn {
  margin-top: 24rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: var(--amber);
  color: #fffdf9;
  font-size: 25rpx;
  font-weight: 700;
}

.done-close {
  display: block;
  margin-top: 16rpx;
  color: var(--faint);
  font-size: 22rpx;
}

@keyframes done-pop {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.reading-page.is-night .done-card {
  box-shadow: 10rpx 12rpx 0 rgba(0, 0, 0, 0.3);
}
