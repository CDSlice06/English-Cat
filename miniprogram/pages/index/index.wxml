<view class="page home tab-page">
  <view wx:if="{{loading}}" class="loading">
    <cat-image custom-class="state-cat" name="sleepy-nap" size="large" />
    <text>正在从云数据库同步…</text>
  </view>
  <view wx:elif="{{error}}" class="error-box">
    <cat-image custom-class="state-cat" name="not-found" size="large" />
    <text class="error-text">{{error}}</text>
    <primary-button text="重新连接" bind:tap="load" />
  </view>
  <block wx:else>
    <view class="topline enter">
      <view class="brand">
        <text class="brand-en en">MIAO</text>
        <view class="brand-copy">
          <text class="brand-name">英语精读喵</text>
          <text class="brand-sub en">reading journal</text>
        </view>
      </view>
      <view class="level-pill">
        <view class="level-dot"></view>
        <text>CET 4 / 6</text>
      </view>
    </view>

    <view class="hero enter d1 {{hasProgress ? 'hero-compact' : ''}}">
      <view class="paper-tape hero-tape"></view>
      <view class="paper-star hero-star"></view>

      <view class="hero-copy">
        <view class="hello">
          <view class="hello-line"></view>
          <text>今天，也读懂一点点</text>
        </view>
        <block wx:if="{{!hasProgress}}">
          <text class="hero-title">读过的每一篇</text>
          <view class="hero-strong hand-wave">
            <text class="hero-title hero-title-strong">都要完全消化</text>
          </view>
          <text class="hero-sub">从一篇文档到词汇、语法与表达，让橘猫陪你走完学习闭环。</text>
        </block>
        <text wx:else class="hero-title hero-title-compact">读过的每一篇，都要完全消化</text>
        <view wx:if="{{hasProgress && catBubble}}" class="cat-bubble cat-bubble-inline">{{catBubble}}</view>
      </view>

      <view class="hero-photo {{catTapped ? 'cat-tapped' : ''}}" bind:tap="tapCat">
        <view class="photo-tape"></view>
        <view class="photo-window">
          <cat-image custom-class="hero-cat-visual" name="{{catName}}" size="large" />
        </view>
        <text class="photo-caption en">today's cat · 戳一下</text>
        <view wx:if="{{!hasProgress && catBubble}}" class="cat-bubble">
          <text>{{catBubble}}</text>
        </view>
      </view>

      <view wx:if="{{!hasProgress}}" class="hero-band">
        <text class="en">WORD</text>
        <view class="band-dot"></view>
        <text class="en">PHRASE</text>
        <view class="band-dot"></view>
        <text class="en">GRAMMAR</text>
        <view class="band-dot"></view>
        <text class="en">OUTPUT</text>
      </view>
    </view>

    <view wx:if="{{plan.visible}}" class="plan-card enter d2">
      <view class="paper-tape plan-tape"></view>
      <view class="plan-head">
        <view class="plan-head-copy">
          <text class="plan-kicker en">TODAY</text>
          <text class="plan-title">今日计划</text>
        </view>
        <view class="plan-count">
          <text class="plan-count-num en">{{plan.done}}</text>
          <text class="plan-count-total">/{{plan.total}}</text>
        </view>
      </view>

      <view wx:if="{{planExpanded}}" class="plan-list">
        <view
          wx:for="{{plan.tasks}}"
          wx:key="key"
          class="plan-row {{item.done ? 'plan-row-done' : ''}}"
        >
          <view class="plan-check">{{item.done ? '✓' : ''}}</view>
          <view class="plan-copy">
            <text class="plan-row-title">{{item.title}}</text>
            <text class="plan-row-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <text wx:if="{{planExpanded && plan.done >= plan.total}}" class="plan-done-text">今天的计划都做完了，可以安心收工。</text>

      <view class="plan-toggle" hover-class="plan-toggle-hover" bindtap="togglePlan">
        <text class="plan-toggle-text">{{planExpanded ? '收起今日计划' : (plan.done >= plan.total ? '今天的计划都做完了 · 展开看看' : '展开今日计划')}}</text>
        <view class="plan-toggle-arrow {{planExpanded ? 'is-open' : ''}}"></view>
      </view>

      <view wx:if="{{planExpanded}}" class="plan-guide" bindtap="goProfile">
        <text class="plan-guide-text">复习和背诵都在「我的」页</text>
        <text class="plan-guide-link">去我的页</text>
      </view>
    </view>

    <view wx:if="{{hasProgress}}" class="progress-card enter d2">
      <view class="paper-tape progress-tape"></view>
      <view class="progress-paw paw-print"></view>

      <view class="progress-head">
        <view class="progress-copy">
          <text class="progress-kicker">THIS ARTICLE</text>
          <text class="progress-title">{{title}}</text>
        </view>
        <view class="progress-badge">{{readingMode ? progress.percent + '%' : progress.completed + '/' + progress.total}}</view>
      </view>

      <view class="stat-strip">
        <view class="stat">
          <text class="stat-num en">{{readingMode ? readingMinutes : mastered}}<text wx:if="{{readingMode}}" class="stat-small">/15</text></text>
          <text class="stat-label">{{readingMode ? '已读分钟' : '已掌握词'}}</text>
        </view>
        <view class="stat">
          <text class="stat-num en">{{readingMode ? pointsCount : progress.completed}}<text wx:if="{{!readingMode}}" class="stat-small">/{{progress.total}}</text></text>
          <text class="stat-label">{{readingMode ? '可点知识点' : '学习单元'}}</text>
        </view>
        <view class="stat">
          <text class="stat-num en">{{progress.percent}}<text class="stat-small">%</text></text>
          <text class="stat-label">本篇进度</text>
        </view>
      </view>

      <view class="step-row">
        <view wx:for="{{stations}}" wx:key="label" class="step-chip {{item.done ? 'step-on' : ''}}"><view class="step-pip"></view><text>{{item.label}}</text></view>
      </view>

      <view class="continue-action">
        <primary-button text="继续学习 · {{nextUnit.label}}" data-url="{{nextUnit.url}}" bind:tap="go" />
        <text class="continue-hint">{{nextUnit.hint}}</text>
      </view>
    </view>

    <view wx:elif="{{!starter}}" class="zero-card enter d2">
      <view class="paper-tape zero-tape"></view>
      <view class="zero-photo">
        <cat-image custom-class="zero-cat" name="sleepy-nap" size="medium" />
      </view>
      <view class="zero-copy">
        <text class="zero-title">猫在等你的第一篇文章</text>
        <text class="zero-desc">从题库抽一篇，或导入自己的 Word / PDF，我们从词汇一路读到输出。</text>
      </view>
      <view class="zero-action">
        <primary-button text="从题库抽一篇" data-url="/pages/library/index" bind:tap="go" />
        <view class="zero-link" data-url="/pages/import/index" bind:tap="go">
          <text>我有文章，直接导入</text>
          <view class="zero-link-arrow"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{starter}}" class="starter-card enter d2">
      <view class="paper-tape starter-tape"></view>
      <view class="starter-head">
        <view class="starter-head-copy">
          <text class="starter-kicker en">FIRST WEEK</text>
          <text class="starter-title">第一周，先做三件小事</text>
        </view>
        <view class="starter-count">
          <text class="starter-count-num en">{{starter.done}}</text>
          <text class="starter-count-total">/3</text>
        </view>
      </view>

      <view class="starter-steps">
        <view
          wx:for="{{starter.steps}}"
          wx:key="key"
          class="starter-step {{item.done ? 'starter-step-done' : ''}}"
          hover-class="{{item.done ? 'none' : 'starter-step-hover'}}"
          data-url="{{item.done ? '' : item.url}}"
          bindtap="go"
        >
          <view class="starter-check">{{item.done ? '✓' : index + 1}}</view>
          <view class="starter-step-copy">
            <text class="starter-step-title">{{item.title}}</text>
            <text class="starter-step-desc">{{item.desc}}</text>
          </view>
          <view wx:if="{{!item.done}}" class="starter-arrow"></view>
        </view>
      </view>

      <view wx:if="{{starter.complete}}" class="starter-finish">
        <cat-image custom-class="starter-cat" name="complete-halo" size="small" />
        <view class="starter-finish-copy">
          <text class="starter-finish-title">三件小事都完成了</text>
          <text class="starter-finish-desc">接下来按自己的节奏读，猫猫继续陪着</text>
        </view>
        <view class="starter-dismiss" hover-class="starter-dismiss-hover" bindtap="dismissStarter">收起</view>
      </view>
    </view>

    <view
      class="checkin-card enter d3"
      hover-class="checkin-hover"
      data-url="/pages/checkin/index"
      bindtap="go"
    >
      <view class="checkin-figure">
        <text class="checkin-num en">{{checkin.streak}}</text>
        <text class="checkin-unit">天连续</text>
      </view>
      <view class="checkin-main">
        <view class="checkin-head">
          <text class="checkin-kicker en">DAILY CHECK-IN</text>
          <text class="checkin-status {{checkin.checkedToday ? 'checkin-status-on' : ''}}">{{checkin.checkedToday ? '已盖章' : '待盖章'}}</text>
        </view>
        <view class="checkin-week">
          <view wx:for="{{checkin.week}}" wx:key="key" class="checkin-day">
            <view class="checkin-dot {{item.checked ? 'checkin-dot-on' : ''}} {{item.today ? 'checkin-dot-today' : ''}}">
              <text wx:if="{{item.checked}}" class="checkin-check">✓</text>
            </view>
            <text class="checkin-day-label">{{item.label}}</text>
          </view>
        </view>
        <text class="checkin-hint">{{checkin.hint}}</text>
      </view>
    </view>

    <view wx:if="{{hasProgress}}" class="cta enter d3">
      <primary-button text="换一篇文章" secondary="{{true}}" data-url="/pages/library/index" bind:tap="go" />
      <view class="cta-hint">
        <view class="cta-hint-dot"></view>
        <text>也可以导入自己的 Word / PDF</text>
      </view>
    </view>

    <view class="home-rule"></view>
    <text class="home-footer">英语精读喵 · 每一次精读都有回响</text>
  </block>
</view>
