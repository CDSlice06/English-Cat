.draw {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx 24rpx 40rpx;
}

.draw-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-md);
  background: var(--paper);
}

.draw-word {
  color: var(--ink);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 44rpx;
  font-weight: 700;
}

.draw-meaning {
  color: var(--ink);
  font-size: 26rpx;
  line-height: 1.6;
}

.draw-tip {
  margin-top: 4rpx;
  color: var(--faint);
  font-size: 21rpx;
  line-height: 1.6;
}

.draw-paper {
  overflow: hidden;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-md);
  background: #fffdf9;
  box-shadow: var(--shadow-paper);
}

.draw-board {
  display: block;
  width: 100%;
  height: 56vh;
}

.draw-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.draw-colors {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.draw-color {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid transparent;
  border-radius: 50%;
}

.draw-color-on {
  border-color: var(--butter);
  box-shadow: 0 0 0 3rpx rgba(75, 64, 52, 0.18);
}

.draw-tool-actions {
  display: flex;
  gap: 12rpx;
}

.draw-tool {
  padding: 12rpx 22rpx;
  border: 2rpx solid var(--paper-line);
  border-radius: var(--r-pill);
  background: var(--paper);
  color: var(--muted);
  font-size: 23rpx;
}

.draw-tool-off {
  opacity: 0.4;
}

.draw-foot {
  display: flex;
  gap: 16rpx;
  margin-top: 6rpx;
}

.draw-skip,
.draw-save {
  flex: 1;
  padding: 22rpx 0;
  border-radius: var(--r-md);
  font-size: var(--fs-body);
  font-weight: 700;
  text-align: center;
}

.draw-skip {
  border: 2rpx solid var(--paper-line);
  background: var(--paper);
  color: var(--muted);
}

.draw-save {
  background: var(--amber);
  color: #fff8e6;
  box-shadow: 2rpx 3rpx 0 rgba(103, 73, 40, 0.14);
}

.draw-save-busy {
  opacity: 0.7;
}
