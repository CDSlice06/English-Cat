/* 热区扩到 88rpx，视觉圆圈保持 52rpx 不变 */
.speak-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: -18rpx;
  background: transparent;
}

.speak-press .speaker {
  transform: translate(1rpx, 1rpx);
  box-shadow: 1rpx 1rpx 0 rgba(116, 72, 40, 0.12);
}

/* 喇叭图标：矢量图，避免小尺寸下伪元素拼形状失真 */
.speaker {
  width: 52rpx;
  height: 52rpx;
  border: 2rpx solid rgba(116, 72, 40, 0.24);
  border-radius: 50%;
  background-color: #fff3d4;
  box-shadow: 2rpx 2rpx 0 rgba(116, 72, 40, 0.12);
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 30rpx 30rpx;
}

.playing .speaker {
  animation: speak-pulse 0.6s ease-in-out infinite alternate;
}

@keyframes speak-pulse {
  from { transform: scale(1); opacity: 0.55; }
  to { transform: scale(1.08); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .playing .speaker { animation: none; }
}
