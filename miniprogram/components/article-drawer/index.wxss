.origin-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 920;
  background: rgba(64, 47, 28, 0.38);
  display: flex;
  align-items: flex-end;
}

.origin-sheet {
  width: 100%;
  height: 76vh;
  display: flex;
  flex-direction: column;
  background: #fffdf6;
  border-top: 2rpx solid rgba(116, 72, 40, 0.45);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 0 rgba(116, 72, 40, 0.10), 0 -2rpx 14rpx rgba(116, 72, 40, 0.10);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.origin-head {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 18rpx;
  border-bottom: 2rpx dashed rgba(199, 121, 63, 0.24);
}

.origin-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.origin-kicker {
  color: var(--faint, #8c8272);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.origin-title {
  color: var(--ink, #3f3327);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.origin-close {
  padding: 14rpx 26rpx;
  border: 2rpx solid rgba(168, 106, 17, 0.34);
  border-radius: 999rpx;
  background: #fff3cf;
  color: #8a5a0d;
  font-size: 22rpx;
  font-weight: 700;
}

.origin-scroll {
  flex: 1;
  min-height: 0;
  padding: 16rpx 28rpx 30rpx;
  box-sizing: border-box;
}

.origin-line {
  padding: 14rpx 18rpx;
  margin-bottom: 8rpx;
  border-left: 4rpx solid transparent;
  border-radius: 13rpx 18rpx 14rpx 16rpx;
}

.origin-active {
  border-left-color: #d08a2c;
  background: rgba(255, 232, 160, 0.55);
}

.origin-text {
  color: var(--ink-2, #6f6557);
  font-family: 'Iowan Old Style', Georgia, 'Songti SC', serif;
  font-size: 25rpx;
  line-height: 1.9;
  word-break: break-word;
}

.origin-active .origin-text {
  color: #4a3419;
}

.origin-foot {
  padding: 22rpx 0 8rpx;
  text-align: center;
  color: var(--faint, #8c8272);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
