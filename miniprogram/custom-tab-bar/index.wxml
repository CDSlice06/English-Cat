<view class="tab-bar">
  <view class="tab-bar-inner">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-item-on' : ''}}"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <view class="tab-icon">
        <block wx:if="{{item.icon === 'home'}}">
          <view class="home-roof"></view>
          <view class="home-body"></view>
        </block>
        <block wx:elif="{{item.icon === 'study'}}">
          <view class="book-page book-page-l"></view>
          <view class="book-page book-page-r"></view>
        </block>
        <block wx:elif="{{item.icon === 'journal'}}">
          <view class="paper-sheet">
            <view class="sheet-band"></view>
            <view class="sheet-line sheet-line-1"></view>
            <view class="sheet-line sheet-line-2"></view>
            <view class="sheet-line sheet-line-3"></view>
          </view>
        </block>
        <block wx:else>
          <view class="cat-head">
            <view class="cat-ear cat-ear-l"></view>
            <view class="cat-ear cat-ear-r"></view>
          </view>
        </block>
      </view>
      <text class="tab-text">{{item.text}}</text>
      <view class="tab-wave"></view>
    </view>
  </view>
</view>
